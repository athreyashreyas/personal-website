---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { ogImageFor } from '../lib/og-routes';

interface Props {
  title: string;
  description?: string;
  /** Constrain the main content to prose measure. Default true. */
  prose?: boolean;
  /** 'article' for a single post or project; 'website' for everything else. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'The personal site of Shreyas Athreya — writing, projects, and a bit of a self-portrait.',
  prose = true,
  ogType = 'website',
} = Astro.props;

const siteName = 'Shreyas Athreya';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;

// Absolute URLs, derived from `site` in astro.config.mjs. Crawlers and every
// social scraper require them absolute — a root-relative og:image is simply
// dropped — so none of this works until `site` is set.
//
// The canonical drops the query string and any trailing slash, so the shelf
// graph's ?tag= links and /recommendations?tag=x don't register as separate
// pages competing with the page they filter.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const ogImage = new URL(await ogImageFor(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Mobile browser chrome matches the page background per theme. These
        cover the pre-JS case; once the reader makes an explicit choice the
        script in SiteScripts rewrites both, since the OS preference no longer
        tells you which theme the page is actually in. */}
    <meta name="theme-color" data-theme-color="light" media="(prefers-color-scheme: light)" content="#FAF8F3" />
    <meta name="theme-color" data-theme-color="dark" media="(prefers-color-scheme: dark)" content="#191A19" />

    <SiteScripts />

    <ClientRouter />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* summary_large_image, not summary: the cards are 1.91:1, and the small
        variant would centre-crop them to a square and cut the title in half. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
  </head>
  <body>
    <div id="nav-progress" aria-hidden="true" transition:persist></div>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="wrap wrap--wide">
        <Nav />
      </div>
    </header>

    <main id="main">
      <div class={prose ? 'wrap' : 'wrap wrap--wide'}>
        <slot />
      </div>
    </main>

    <div class="wrap wrap--wide">
      <Footer />
    </div>

    <SearchPalette />
  </body>
</html>
