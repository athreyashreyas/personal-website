---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Constrain the main content to prose measure. Default true. */
  prose?: boolean;
}

const {
  title,
  description = 'The personal site of Shreyas Athreya — writing, projects, and a bit of a self-portrait.',
  prose = true,
} = Astro.props;

const siteName = 'Shreyas Athreya';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Mobile browser chrome matches the page background per theme. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF8F3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#2E2A25" />

    {/* No-flash theme init: set data-theme before first paint. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* if storage/matchMedia unavailable, CSS media query handles it */
        }
      })();
    </script>

    {/* Theme toggle, delegated at the document so it survives in-place
        (view-transition) navigations. Guarded to bind exactly once. */}
    <script is:inline>
      (function () {
        if (window.__themeToggleBound) return;
        window.__themeToggleBound = true;
        function current() {
          return document.documentElement.getAttribute('data-theme') === 'dark'
            ? 'dark'
            : 'light';
        }
        // View-transition swaps copy the incoming (server-rendered) <html>'s
        // attributes over the current ones, wiping the client-set data-theme.
        // Re-apply it right after each swap, before paint, so there's no flash.
        function applyTheme() {
          try {
            var stored = localStorage.getItem('theme');
            var theme =
              stored ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light');
            document.documentElement.setAttribute('data-theme', theme);
          } catch (e) {
            /* storage/matchMedia unavailable; CSS media query handles it */
          }
        }
        document.addEventListener('astro:after-swap', applyTheme);
        function reflect() {
          var btn = document.getElementById('theme-toggle');
          if (btn) btn.setAttribute('aria-pressed', String(current() === 'dark'));
        }
        document.addEventListener('click', function (e) {
          var btn =
            e.target && e.target.closest ? e.target.closest('#theme-toggle') : null;
          if (!btn) return;
          var next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (err) {
            /* storage unavailable; toggle still works for the session */
          }
          reflect();
        });
        document.addEventListener('astro:page-load', reflect);

        // Follow the OS theme live — but only while the reader hasn't made an
        // explicit choice (no stored preference). An explicit toggle wins.
        try {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          mq.addEventListener('change', function (e) {
            if (!localStorage.getItem('theme')) {
              document.documentElement.setAttribute(
                'data-theme',
                e.matches ? 'dark' : 'light',
              );
              reflect();
            }
          });
        } catch (err) {
          /* matchMedia unavailable; initial inference still applies */
        }

        reflect();
      })();
    </script>

    {/* The nav is transition:persist'd (so it doesn't cross-fade and briefly
        show two selected items). Because it persists, re-mark the current
        link ourselves after each navigation. */}
    <script is:inline>
      (function () {
        if (window.__navCurrentBound) return;
        window.__navCurrentBound = true;
        function trim(p) {
          return p.replace(/\/+$/, '') || '/';
        }
        function updateNavCurrent() {
          var path = trim(location.pathname);
          document.querySelectorAll('.site-nav a[href]').forEach(function (a) {
            var href = trim(a.getAttribute('href'));
            var isCurrent =
              href === '/'
                ? path === '/'
                : path === href || path.indexOf(href + '/') === 0;
            if (isCurrent) a.setAttribute('aria-current', 'page');
            else a.removeAttribute('aria-current');
          });
        }
        document.addEventListener('astro:page-load', updateNavCurrent);
        updateNavCurrent();
      })();
    </script>

    {/* Close the mobile nav dropdown after navigating or clicking outside it.
        The <details> element handles opening; this just tidies it away. */}
    <script is:inline>
      (function () {
        if (window.__navMenuBound) return;
        window.__navMenuBound = true;
        function closeMenus() {
          document.querySelectorAll('details.nav-dd[open]').forEach(function (d) {
            d.open = false;
          });
        }
        document.addEventListener('click', function (e) {
          var t = e.target;
          var dd = t && t.closest ? t.closest('details.nav-dd') : null;
          // A link inside the menu was clicked: let it navigate, then close.
          if (dd && t.closest('a')) {
            closeMenus();
            return;
          }
          // A click anywhere outside an open menu closes it.
          if (!dd) closeMenus();
        });
        document.addEventListener('astro:page-load', closeMenus);
      })();
    </script>

    {/* Top navigation progress bar. Starts when a view-transition navigation
        begins, completes when the new page has loaded. Bound once; the bar
        element is transition:persist'd so its state survives the swap. */}
    <script is:inline>
      (function () {
        if (window.__navProgressBound) return;
        window.__navProgressBound = true;
        var doneTimer;
        function bar() {
          return document.getElementById('nav-progress');
        }
        function start() {
          var el = bar();
          if (!el) return;
          clearTimeout(doneTimer);
          el.classList.remove('is-done');
          // Reset to 0 without a transition, then force reflow so the grow
          // animation runs from the start on every navigation.
          el.classList.remove('is-loading');
          void el.offsetWidth;
          el.classList.add('is-loading');
        }
        function done() {
          var el = bar();
          if (!el) return;
          el.classList.remove('is-loading');
          el.classList.add('is-done');
          // After the fade-out, return to the idle base state.
          doneTimer = setTimeout(function () {
            el.classList.remove('is-done');
          }, 500);
        }
        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:page-load', done);
      })();
    </script>

    <ClientRouter />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div id="nav-progress" aria-hidden="true" transition:persist></div>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="wrap wrap--wide">
        <Nav />
      </div>
    </header>

    <main id="main">
      <div class={prose ? 'wrap' : 'wrap wrap--wide'}>
        <slot />
      </div>
    </main>

    <div class="wrap wrap--wide">
      <Footer />
    </div>
  </body>
</html>
