---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import ProjectLogo from '../../components/ProjectLogo.astro';
// The screenshot "stills" a project write-up can drop into its body as bare
// <XyzStill /> tags. See components/stills/index.ts for why they're passed in
// rather than imported by the MDX itself.
import { stillComponents } from '../../components/stills';
// The interactive widgets a write-up can embed the same way. Merged with the
// stills below so MDX sees one flat map of available tags.
import { embedComponents } from '../../components/embeds';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, links } = project.data;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="project-head">
      <p class="meta">
        <a class="back-link" href="/projects">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 6l-6 6 6 6" />
          </svg>
          Go back to all projects
        </a>
      </p>
      <div class="title-row">
        <ProjectLogo slug={project.id} size={54} />
        <h1><span class="hl-title">{title}</span></h1>
        {status && <span class="status">{status}</span>}
      </div>
      <p class="lede">{description}</p>
      {
        (links.repo || links.live) && (
          <div class="links">
            <ProjectLinks links={links} />
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content components={{ ...stillComponents, ...embedComponents }} />
    </div>
  </article>
</BaseLayout>

<style>
  .project-head {
    margin-bottom: 2.5rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .title-row h1 {
    margin-bottom: 0;
  }

  /* Breadcrumb back-link with a leading arrow. */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .back-link svg {
    width: 1em;
    height: 1em;
  }
  .back-link:hover {
    color: var(--accent-link);
    text-decoration: none;
  }
  /* Nudge the arrow left on hover, so the "go back" reads as motion. */
  .back-link:hover svg {
    transform: translateX(-2px);
    transition: transform 0.15s ease;
  }

  .status {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15em 0.5em;
  }

  .lede {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .links {
    margin: 0.75rem 0 0;
    display: flex;
    gap: 1.1rem;
  }

  .prose :global(h2),
  .prose :global(h3) {
    color: var(--accent-heading);
  }
  .prose :global(img) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-block: 1.6em;
  }
</style>
