---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = (await getCollection('recommendations')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Render each item's rich note inline in the list.
const rendered = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<BaseLayout title="Recommendations">
  <header class="page-head">
    <h1><span class="hl-title">Recommendations</span></h1>
    <p class="page-sub">Books, links, tools, and interesting things worth your time.</p>
  </header>

  {
    rendered.length === 0 ? (
      <p class="meta">Nothing here yet.</p>
    ) : (
      <ul class="rec-list">
        {rendered.map(({ item, Content }) => (
          <li>
            <div class="row">
              {item.data.url ? (
                <a class="name" href={item.data.url} target="_blank" rel="noopener">
                  {item.data.title}
                </a>
              ) : (
                <span class="name">{item.data.title}</span>
              )}
              {item.data.category && <span class="cat">{item.data.category}</span>}
            </div>
            {
              item.data.tags && item.data.tags.length > 0 && (
                <ul class="tags">
                  {item.data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )
            }
            <div class="note">
              <Content />
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-sub {
    margin: 0.1rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .rec-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rec-list > li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .rec-list > li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  a.name:hover {
    color: var(--accent-link);
    text-decoration: none;
  }

  .cat {
    font-family: var(--font-sans);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.05em 0.5em;
  }

  .note {
    margin-top: 0.5rem;
    max-width: 60ch;
  }
  .note :global(p) {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
  }
  .note :global(p:first-child) {
    margin-top: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55em;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    color: var(--text-secondary);
  }
  .tags li:not(:last-child)::after {
    content: '|';
    margin-left: 0.55em;
    color: var(--border);
  }
  .tags + .note {
    margin-top: 0.6rem;
  }
</style>
