---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderPage } from '../../lib/pages';
// The interactive blocks the Lab body can embed as bare <XyzWidget /> tags —
// see components/embeds/index.ts for why they're passed in rather than
// imported by the MDX itself.
import { embedComponents } from '../../components/embeds';

// Editable in the CMS under "Lab page" (src/content/lab.mdx).
const { Content } = await renderPage('lab');
---

<BaseLayout
  title="Lab"
  description="One-off interactive things: games, visualizations, and artefacts that don't belong anywhere else."
  prose={false}
>
  <article class="lab">
    <h1><span class="hl-title">Lab</span></h1>
    <Content components={embedComponents} />
  </article>
</BaseLayout>

<style>
  .lab :global(h2) {
    margin-top: 2.75rem;
    color: var(--accent-heading);
  }
  /* Prose stays at a comfortable measure while the embedded widgets are free
     to use the full width of the wide wrapper. */
  .lab :global(p),
  .lab :global(ul),
  .lab :global(ol) {
    max-width: var(--measure);
  }
</style>
