---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

// Editable in the CMS under "Home intro" (src/content/home.mdx).
const home = await getEntry('pages', 'home');
const { Content } = await render(home!);
---

<BaseLayout title="Shreyas Athreya">
  <section class="intro">
    <Content />
  </section>
</BaseLayout>

<style>
  .intro {
    margin-top: 1rem;
    max-width: 60ch;
  }

  /* Rendered from MDX, so target the paragraphs globally. Same size as regular
     body text. */
  .intro :global(p) {
    font-size: 1.1875rem;
    line-height: 1.7;
    color: var(--text-primary);
    text-align: justify;
  }
</style>
