---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import { getEntry, render } from 'astro:content';

// Editable in the CMS under "Home intro" (src/content/home.mdx).
const home = await getEntry('pages', 'home');
const { Content } = await render(home!);
---

<BaseLayout title="Shreyas Athreya">
  <section class="intro">
    <Content />

    {/* Closes the letter — picks up the last line about the motorcycle. Kept
        out of home.mdx so that file stays plain prose for the CMS. */}
    <Figure
      src="/images/home/shreyas-beach-1000.webp"
      srcset="/images/home/shreyas-beach-1000.webp 1000w, /images/home/shreyas-beach-1600.webp 1600w"
      alt="Shreyas standing in the surf at dusk, waves breaking behind him under a pink sky."
      width={1600}
      height={1067}
      protect
    >
      <Fragment slot="caption">
        At <a
          href="https://www.google.com/maps/search/Marina+Beach,+Chennai"
          target="_blank"
          rel="noopener">Marina Beach</a
        > on a beautiful summer evening after a ride.
      </Fragment>
    </Figure>
  </section>
</BaseLayout>

{/* Keep the top nav-progress bar (see BaseLayout) loading until this hero
    image has actually decoded, not just until the rest of the page has —
    otherwise the page reads as "done" right before the image pops in, which
    is exactly the flicker this is meant to avoid on slow connections. Sets
    window.__navProgressGate, which BaseLayout's own page-load handler reads
    instead of completing the bar unconditionally. Astro dedupes identical
    inline scripts by content, so on a repeat client-side visit to this page
    this body may not re-run — the immediate call below still covers a fresh
    hard load, and the gate function itself re-queries the DOM live on every
    call, so the (possibly stale) window reference from an earlier visit
    still resolves against whichever page is current — including falling
    back to a normal done() once the user has navigated to a page that has
    no such image, so the reference left behind doesn't strand the bar. */}
<script is:inline>
  (function () {
    function gate() {
      var np = window.__navProgress;
      if (!np) return;
      var img = document.querySelector('.intro .figure img');
      if (!img) {
        np.done();
        return;
      }
      if (img.complete && img.naturalWidth > 0) {
        np.done();
        return;
      }
      var bar = document.getElementById('nav-progress');
      if (bar && !bar.classList.contains('is-loading')) np.start();
      img.addEventListener('load', np.done, { once: true });
      img.addEventListener('error', np.done, { once: true });
    }
    window.__navProgressGate = gate;
    gate();
  })();
</script>

<style>
  .intro {
    margin-top: 1rem;
    max-width: 60ch;
  }

  /* Rendered from MDX, so target the paragraphs globally. Same size as regular
     body text. */
  .intro :global(p) {
    font-size: 1.1875rem;
    line-height: 1.7;
    color: var(--text-primary);
    text-align: justify;
  }

  /* Phone portrait: left-align (justify opens rivers in the narrow measure).
     Set here because this scoped rule outranks the global .intro override. */
  @media (max-width: 640px) {
    .intro :global(p) {
      text-align: left;
    }
  }
</style>
