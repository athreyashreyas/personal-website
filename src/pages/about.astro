---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderPage } from '../lib/pages';

// Editable in the CMS under "About page" (src/content/about.mdx).
const { Content } = await renderPage('about');
---

<BaseLayout title="About">
  <article class="prose">
    <h1><span class="hl-title">About</span></h1>
    <Content />
  </article>
</BaseLayout>

<style>
  .prose :global(h2) {
    color: var(--accent-heading);
  }
</style>
