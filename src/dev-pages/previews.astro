---
// Scratch page for Lab candidates — where a Lab idea gets tried before it
// earns a place on /lab.
//
// DEV ONLY. This file sits outside src/pages on purpose, so Astro's file-based
// routing cannot pick it up and no production build can emit it. It is mounted
// at /lab/previews by an injectRoute in astro.config.mjs that only runs under
// `astro dev` — see the labPreviews integration there.
//
// It used to live at src/pages/lab/previews.astro, which meant it shipped: the
// only things keeping it out of sight were a Disallow in robots.txt and a
// sitemap filter, neither of which stops anyone who has the URL. Half-finished
// work should not be reachable on the live site at all.
//
// The shelf graph that started here now ships as
// components/embeds/ShelfGraphWidget.astro and is live on /lab. It stays here
// with its sample-data toggle, which the shipped widget drops, because that is
// the only way to see how the layout behaves at a couple of dozen entries.
import BaseLayout from '../layouts/BaseLayout.astro';
import { shelfItems } from '../lib/shelf';

// Handed to the client on a data attribute rather than via define:vars, which
// would stop the module below from being bundled.
//
// NB: never write a literal script tag in this frontmatter, not even inside a
// comment. The compiler splits the file on that text wherever it appears, so
// everything after it gets handed to esbuild as JavaScript and the dev server
// fails its dependency scan with a parse error pointing at the comment.
const shelf = await shelfItems();
---

<BaseLayout title="Lab previews" prose={false}>
  <header class="page-head">
    <h1><span class="hl-title">Lab previews</span></h1>
    <p class="page-sub">One candidate. Nothing here is finished.</p>
  </header>

  <section class="sketch" id="sketch-shelf">
    <div class="sketch-head">
      <h2>The shelf</h2>
      <p class="blurb">
        Everything on the recommendations page as a graph. Large nodes are the
        entries, coloured by what kind of thing each one is; small nodes are the
        tags they share. Nothing about the shape is authored — it is whatever
        the collection happens to be. Hover a node to isolate what it touches,
        drag one to pull the rest along, click an entry to open it.
      </p>
    </div>

    <div class="stage">
      <div class="controls">
        <span class="seg">
          <button type="button" class="btn is-on" data-shelf-mode="real">
            Real ({shelf.length})
          </button>
          <button type="button" class="btn" data-shelf-mode="sample">Sample (14)</button>
        </span>
        <output class="readout" data-shelf-readout></output>
      </div>
      <canvas class="canvas" data-shelf-canvas data-shelf-items={JSON.stringify(shelf)}></canvas>
      <ul class="legend" data-shelf-legend></ul>
      <p class="caption">
        The sample set is invented, and only here to show what the graph looks
        like once the real shelf is a couple of dozen entries deep.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-sub {
    margin: 0.1rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .sketch-head h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .blurb {
    margin: 0.35rem 0 0;
    max-width: 62ch;
    color: var(--text-secondary);
  }

  .stage {
    margin-top: 1rem;
  }

  .canvas {
    display: block;
    width: 100%;
    height: 520px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    /* pan-y, not none — see ShelfGraphWidget: `none` traps the page scroll on
       a phone for anyone whose finger lands on the canvas. */
    touch-action: pan-y;
    cursor: grab;
  }
  .canvas.is-grabbing {
    cursor: grabbing;
  }

  /* Built in JS from whichever categories the collection actually contains,
     so its rows need :global to pick these up. */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    color: var(--text-secondary);
  }
  .legend :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .legend :global(.swatch) {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }
  .legend :global(li.is-tag .swatch) {
    width: 0.42em;
    height: 0.42em;
  }

  .caption {
    margin: 0.6rem 0 0;
    max-width: 62ch;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    color: var(--text-secondary);
  }

  .btn {
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.35em 0.9em;
    cursor: pointer;
  }
  .btn:hover {
    border-color: var(--accent-link);
    color: var(--accent-link);
  }
  .btn.is-on {
    border-color: var(--accent-heading);
    color: var(--accent-heading);
  }
  .seg {
    display: inline-flex;
    gap: 0.35rem;
  }

  .readout {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .canvas {
      height: 420px;
    }
  }
</style>

<script>
  const cleanups: Array<() => void> = [];
  const SANS = "'Plus Jakarta Sans', system-ui, sans-serif";
  const SERIF = "'Newsreader', Georgia, serif";

  function palette() {
    const cs = getComputedStyle(document.documentElement);
    const v = (n: string) => cs.getPropertyValue(n).trim();
    return {
      bg: v('--bg'),
      text: v('--text-primary'),
      dim: v('--text-secondary'),
      border: v('--border'),
      accent: v('--accent-link'),
      heading: v('--accent-heading'),
    };
  }

  /** Re-express a theme color at a given alpha. The theme tokens are registered
      as `<color>`-typed custom properties, so getComputedStyle returns
      `rgb(r, g, b)` rather than the authored hex — parse both. Canvas silently
      ignores an unparseable value, so getting this wrong fails invisibly. */
  function withAlpha(color: string, a: number) {
    const fn = color.match(/rgba?\(([^)]+)\)/i);
    if (fn) {
      const [r, g, b] = fn[1].split(/[\s,/]+/).filter(Boolean).map(Number);
      return `rgba(${r}, ${g}, ${b}, ${a})`;
    }
    const h = color.replace('#', '').trim();
    const full = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
    const n = parseInt(full, 16);
    return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
  }

  /** Sizes a canvas to its CSS box and DPR. `onResize` intentionally does not
      fire for the first sizing: callers hold the returned ctx in a const, and a
      synchronous callback would touch that binding inside its temporal dead
      zone. Callers draw their own first frame. */
  function fitCanvas(canvas: HTMLCanvasElement, onResize?: () => void) {
    const ctx = canvas.getContext('2d')!;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    const ro = new ResizeObserver(() => {
      size();
      onResize?.();
    });
    ro.observe(canvas);
    cleanups.push(() => ro.disconnect());
    return ctx;
  }

  /** Repaints every frame until the theme transition finishes, coalescing rapid
      switches into one window. See the fuller note in
      components/embeds/ShelfGraphWidget.astro — the tokens are animated, so a
      single redraw on the change event strands the canvas on a colour part-way
      between the two themes. */
  function onThemeChange(fn: () => void) {
    const SETTLE_MS = 340;
    let raf = 0;
    let until = 0;

    const pump = () => {
      fn();
      raf = performance.now() < until ? requestAnimationFrame(pump) : 0;
    };
    const bump = () => {
      until = performance.now() + SETTLE_MS;
      if (!raf) raf = requestAnimationFrame(pump);
    };

    const mo = new MutationObserver(bump);
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', bump);
    cleanups.push(() => {
      mo.disconnect();
      mq.removeEventListener('change', bump);
      cancelAnimationFrame(raf);
    });
  }

  function on<K extends keyof HTMLElementEventMap>(
    el: EventTarget,
    type: K,
    fn: (e: HTMLElementEventMap[K]) => void,
  ) {
    el.addEventListener(type, fn as EventListener);
    cleanups.push(() => el.removeEventListener(type, fn as EventListener));
  }

  /** One hue per kind of entry, so a book and a newsletter don't read as the
      same thing. Kept desaturated and warm enough to sit on the paper
      background — the site's own two greens are only two values, which isn't
      enough to carry a categorical scale. Each pair is [light theme, dark
      theme]; the dark values are lifted, since the light ones go muddy on
      charcoal. `tag` is deliberately the odd one out: neutral, so the tags
      read as the connective tissue between entries rather than as content. */
  const HUES: Record<string, [string, string]> = {
    book: ['#2F7D5F', '#7FCBA9'],
    essay: ['#B4552F', '#E08A5F'],
    newsletter: ['#8A5FA0', '#C09AD4'],
    link: ['#3E7191', '#8CB8D6'],
    talk: ['#A07A22', '#DCB65F'],
    film: ['#A24A6B', '#D690A8'],
    tag: ['#8C8578', '#9C958A'],
    other: ['#5C7A6B', '#93B3A2'],
  };

  type Item = { title: string; url: string | null; category: string | null; tags: string[] };
  type Node = {
    label: string;
    kind: 'item' | 'tag';
    /** Key into HUES — the entry's category, or 'tag'. */
    hue: string;
    url: string | null;
    deg: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    pinned: boolean;
  };
  type Rect = { x: number; y: number; w: number; h: number };

  // Invented, and only here to show the shape at a realistic size.
  const SAMPLE: Item[] = [
    { title: 'From Third World to First', url: null, category: 'Book', tags: ['governance', 'public policy', 'non-fiction'] },
    { title: 'The Mom Test', url: null, category: 'Book', tags: ['customer discovery', 'startups', 'product'] },
    { title: 'Poor Economics', url: null, category: 'Book', tags: ['development', 'economics', 'india'] },
    { title: 'India After Gandhi', url: null, category: 'Book', tags: ['india', 'history', 'non-fiction'] },
    { title: 'Seeing Like a State', url: null, category: 'Book', tags: ['governance', 'systems', 'public policy'] },
    { title: 'Thinking in Systems', url: null, category: 'Book', tags: ['systems', 'economics'] },
    { title: 'High Output Management', url: null, category: 'Book', tags: ['management', 'product'] },
    { title: 'Working Backwards', url: null, category: 'Book', tags: ['product', 'management', 'startups'] },
    { title: 'The Anarchy', url: null, category: 'Book', tags: ['india', 'history'] },
    { title: 'Do Things That Don’t Scale', url: null, category: 'Link', tags: ['startups', 'product'] },
    { title: 'An Uncertain Glory', url: null, category: 'Book', tags: ['india', 'development', 'public policy'] },
    { title: 'A talk on state capacity', url: null, category: 'Talk', tags: ['governance', 'non-fiction'] },
    { title: 'Gulzar on Loneliness', url: null, category: 'Essay', tags: ['writing', 'non-fiction'] },
    { title: 'Bits about Money', url: null, category: 'Newsletter', tags: ['economics', 'systems', 'writing'] },
  ];

  function initShelf() {
    const canvas = document.querySelector('[data-shelf-canvas]') as HTMLCanvasElement | null;
    const readout = document.querySelector('[data-shelf-readout]') as HTMLElement | null;
    const legend = document.querySelector('[data-shelf-legend]') as HTMLElement | null;
    if (!canvas || !readout) return;

    let real: Item[] = [];
    try {
      real = JSON.parse(canvas.dataset.shelfItems || '[]');
    } catch {
      real = [];
    }

    let colors = palette();
    let showing: Item[] = [];
    let nodes: Node[] = [];
    let links: Array<[number, number]> = [];
    let adjacency: Set<number>[] = [];
    let alpha = 1;
    let settled = false;
    let hover = -1;
    let drag = -1;
    let anim = 0;
    // World → screen, recomputed each draw so the graph always fills the box.
    let view = { s: 1, ox: 0, oy: 0 };

    const radius = (n: Node) =>
      n.kind === 'item' ? 6 + Math.min(4, n.deg * 0.7) : 2.4 + Math.min(3.6, n.deg * 0.7);

    /** Categories are free text in the CMS, so anything unrecognised falls
        through to `other` rather than vanishing into the background colour. */
    const hueKey = (cat: string | null) => {
      const k = (cat || '').trim().toLowerCase();
      return k && HUES[k] ? k : 'other';
    };
    // Theme is read off the resolved --bg rather than the media query, so the
    // manual toggle and the system preference both land in the right branch.
    const isDark = () => {
      const m = colors.bg.match(/\d+/g);
      if (!m) return false;
      const [r, g, b] = m.map(Number);
      return 0.299 * r + 0.587 * g + 0.114 * b < 128;
    };
    const hue = (key: string) => (HUES[key] || HUES.other)[isDark() ? 1 : 0];

    /** Bipartite: a node per book, a node per tag, an edge for each tagging.
        Books that share a tag end up pulled together by that tag alone, which
        is the whole point — no adjacency is authored anywhere. */
    function build(items: Item[]) {
      const index = new Map<string, number>();
      showing = items;
      nodes = [];
      links = [];

      items.forEach((it) => {
        index.set(`i:${it.title}`, nodes.length);
        nodes.push({
          label: it.title, kind: 'item', hue: hueKey(it.category), url: it.url,
          deg: it.tags.length,
          x: 0, y: 0, vx: 0, vy: 0, pinned: false,
        });
      });
      items.forEach((it) => {
        const from = index.get(`i:${it.title}`)!;
        it.tags.forEach((tag) => {
          const key = `t:${tag}`;
          let to = index.get(key);
          if (to === undefined) {
            to = nodes.length;
            index.set(key, to);
            nodes.push({
              label: tag, kind: 'tag', hue: 'tag', url: null, deg: 0,
              x: 0, y: 0, vx: 0, vy: 0, pinned: false,
            });
          }
          nodes[to].deg++;
          links.push([from, to]);
        });
      });

      adjacency = nodes.map(() => new Set<number>());
      links.forEach(([a, b]) => {
        adjacency[a].add(b);
        adjacency[b].add(a);
      });

      // Deterministic seeding — books on an inner ellipse, tags on an outer one
      // — so the layout settles the same way on every load instead of
      // untangling from a different knot each time. Wider than tall, matching
      // the canvas, so it doesn't have to unfold sideways later.
      const itemCount = items.length;
      const tagCount = nodes.length - itemCount;
      let ci = 0;
      let ct = 0;
      nodes.forEach((n) => {
        if (n.kind === 'item') {
          const a = (ci++ / Math.max(1, itemCount)) * Math.PI * 2;
          n.x = Math.cos(a) * 115;
          n.y = Math.sin(a) * 72;
        } else {
          const a = (ct++ / Math.max(1, tagCount)) * Math.PI * 2 + 0.5;
          n.x = Math.cos(a) * 245;
          n.y = Math.sin(a) * 155;
        }
      });

      alpha = 1;
      settled = false;
      hover = -1;
      drag = -1;
      readout!.textContent = `${itemCount} items · ${tagCount} tags · ${links.length} links`;
      drawLegend(items);
      run();
    }

    /** Only the categories this dataset actually uses, in the order the
        collection presents them — a fixed legend would list hues that aren't
        on screen. */
    function drawLegend(items: Item[]) {
      if (!legend) return;
      const keys: string[] = [];
      items.forEach((it) => {
        const k = hueKey(it.category);
        if (!keys.includes(k)) keys.push(k);
      });
      keys.push('tag');

      legend.innerHTML = '';
      keys.forEach((k) => {
        const li = document.createElement('li');
        if (k === 'tag') li.classList.add('is-tag');
        li.style.color = hue(k);
        const dot = document.createElement('span');
        dot.className = 'swatch';
        li.append(dot, document.createTextNode(k === 'other' ? 'uncategorised' : k));
        legend!.appendChild(li);
      });
    }

    function step() {
      const REP = 9000;
      const SPRING = 0.03;
      const REST = 92;
      // Gravity is weaker horizontally, so the graph settles into the canvas's
      // landscape box rather than a circle inside it — labels are wide, and the
      // extra horizontal room is what stops them stacking up. Equilibrium
      // spread on an axis goes as 1/sqrt(gravity), so dividing the x pull by
      // aspect² lands the cloud at the canvas's own aspect ratio instead of an
      // arbitrary hardcoded one.
      const aspect = Math.max(1, canvas!.clientWidth / Math.max(1, canvas!.clientHeight));
      const GRAV_Y = 0.016;
      const GRAV_X = GRAV_Y / (aspect * aspect);
      const DAMP = 0.85;
      // Books repel each other harder than tags do, which is what stops two
      // titles landing close enough that their labels fight.
      const ITEM_REP = 2.6;

      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) {
            // Perfectly coincident nodes have no direction to push apart along.
            dx = (i % 7) - 3;
            dy = (j % 5) - 2;
            d2 = dx * dx + dy * dy || 1;
          }
          const boost = a.kind === 'item' && b.kind === 'item' ? ITEM_REP : 1;
          const d = Math.sqrt(d2);
          const f = (REP * boost) / d2;
          const ux = (dx / d) * f;
          const uy = (dy / d) * f;
          a.vx += ux; a.vy += uy;
          b.vx -= ux; b.vy -= uy;
        }
      }

      for (const [i, j] of links) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 1;
        const f = (d - REST) * SPRING;
        const ux = (dx / d) * f;
        const uy = (dy / d) * f;
        a.vx += ux; a.vy += uy;
        b.vx -= ux; b.vy -= uy;
      }

      for (const n of nodes) {
        n.vx -= n.x * GRAV_X;
        n.vy -= n.y * GRAV_Y;
        if (n.pinned) {
          n.vx = 0;
          n.vy = 0;
          continue;
        }
        n.vx *= DAMP;
        n.vy *= DAMP;
        n.x += n.vx * alpha;
        n.y += n.vy * alpha;
      }
      alpha *= 0.985;
      if (alpha < 0.05) settled = true;
    }

    const overlaps = (a: Rect, b: Rect) =>
      a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;

    /** Greedy label placement. Each label gets four candidate slots around its
        node; the first that clears everything already on the canvas wins, and a
        label with no free slot is simply dropped rather than drawn on top of
        another one. Books are placed first so a tag never displaces a title.
        Whatever gets dropped is still reachable by hovering the node. */
    function placeLabels(order: number[], occupied: Rect[], w: number, h: number) {
      const placed: Array<{ i: number; rect: Rect; align: CanvasTextAlign; tx: number }> = [];

      for (const i of order) {
        const n = nodes[i];
        const item = n.kind === 'item';
        ctx.font = item ? `500 13px ${SERIF}` : `500 9.5px ${SANS}`;
        const text = item ? n.label : n.label.toUpperCase();
        const tw = ctx.measureText(text).width;
        const th = item ? 15 : 11;
        const cx = n.x * view.s + view.ox;
        const cy = n.y * view.s + view.oy;
        const r = radius(n) + 5;

        const slots: Array<{ rect: Rect; align: CanvasTextAlign; tx: number }> = [
          { rect: { x: cx - tw / 2, y: cy + r, w: tw, h: th }, align: 'center', tx: cx },
          { rect: { x: cx - tw / 2, y: cy - r - th, w: tw, h: th }, align: 'center', tx: cx },
          { rect: { x: cx + r, y: cy - th / 2, w: tw, h: th }, align: 'left', tx: cx + r },
          { rect: { x: cx - r - tw, y: cy - th / 2, w: tw, h: th }, align: 'right', tx: cx - r },
        ];

        // A node near an edge can have all four slots hang off the canvas. For
        // an entry that matters — the titles are the content — so slide the
        // label back inside and take it if it's still clear of everything.
        // Tags get no such rescue; a dropped tag is recoverable by hovering.
        if (item) {
          const cx2 = Math.max(8, Math.min(cx - tw / 2, w - 8 - tw));
          slots.push(
            { rect: { x: cx2, y: cy + r, w: tw, h: th }, align: 'left', tx: cx2 },
            { rect: { x: cx2, y: cy - r - th, w: tw, h: th }, align: 'left', tx: cx2 },
          );
        }

        for (const slot of slots) {
          const { x, y, w: rw, h: rh } = slot.rect;
          if (x < 8 || y < 8 || x + rw > w - 8 || y + rh > h - 8) continue;
          const pad = { x: x - 3, y: y - 2, w: rw + 6, h: rh + 4 };
          if (occupied.some((o) => overlaps(pad, o))) continue;
          occupied.push(pad);
          placed.push({ i, ...slot });
          break;
        }
      }
      return placed;
    }

    function draw() {
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      ctx.fillStyle = colors.bg;
      ctx.fillRect(0, 0, w, h);
      if (!nodes.length) return;

      /* Fit the current cloud into the box, leaving a margin for labels —
         but hold it still for the duration of a drag. The drag handler inverts
         this transform to turn a pointer position into world coordinates, so
         re-deriving it from a bounding box the dragged node is part of feeds
         back on itself and the whole graph lurches. Same fix as the shipped
         widget in components/embeds/ShelfGraphWidget.astro. */
      if (drag < 0) {
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        for (const n of nodes) {
          minX = Math.min(minX, n.x); maxX = Math.max(maxX, n.x);
          minY = Math.min(minY, n.y); maxY = Math.max(maxY, n.y);
        }
        const pad = w < 560 ? 40 : 64;
        const s = Math.min(
          (w - pad * 2) / Math.max(1, maxX - minX),
          (h - pad * 2) / Math.max(1, maxY - minY),
          1.5,
        );
        view = {
          s,
          ox: w / 2 - ((minX + maxX) / 2) * s,
          oy: h / 2 - ((minY + maxY) / 2) * s,
        };
      }
      const X = (n: Node) => n.x * view.s + view.ox;
      const Y = (n: Node) => n.y * view.s + view.oy;

      const near = hover >= 0 ? adjacency[hover] : null;
      const lit = (i: number) => !near || i === hover || near.has(i);

      // Links first, under everything.
      ctx.lineWidth = 1;
      for (const [a, b] of links) {
        const strong = near ? lit(a) && lit(b) : false;
        ctx.strokeStyle = near
          ? strong
            ? withAlpha(colors.accent, 0.75)
            : withAlpha(colors.border, 0.3)
          : withAlpha(colors.border, 0.85);
        ctx.beginPath();
        ctx.moveTo(X(nodes[a]), Y(nodes[a]));
        ctx.lineTo(X(nodes[b]), Y(nodes[b]));
        ctx.stroke();
      }

      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        const on = lit(i);
        const r = radius(n);
        ctx.beginPath();
        ctx.arc(X(n), Y(n), i === hover ? r * 1.4 : r, 0, Math.PI * 2);
        ctx.fillStyle = withAlpha(hue(n.hue), on ? (n.kind === 'item' ? 1 : 0.85) : 0.26);
        ctx.fill();
      }

      // Labels fade in once the layout stops moving — during the settle they'd
      // be re-solving their slots every frame and reading as a flicker.
      const fade = settled ? 1 : Math.max(0, Math.min(1, (0.3 - alpha) / 0.25));
      if (fade <= 0.01) return;

      // Nodes themselves are obstacles, so a label never lands on a dot.
      const occupied: Rect[] = nodes.map((n) => {
        const r = radius(n) + 3;
        return { x: X(n) - r, y: Y(n) - r, w: r * 2, h: r * 2 };
      });

      // Hovering isolates: only the hovered node's own neighbourhood is
      // labelled, which is what makes a dense graph readable at all.
      const candidates = near
        ? [hover, ...Array.from(near)]
        : nodes
            .map((_, i) => i)
            .sort((a, b) => {
              const ka = nodes[a].kind === 'item' ? 0 : 1;
              const kb = nodes[b].kind === 'item' ? 0 : 1;
              return ka - kb || nodes[b].deg - nodes[a].deg;
            });

      for (const p of placeLabels(candidates, occupied, w, h)) {
        const n = nodes[p.i];
        const item = n.kind === 'item';
        const text = item ? n.label : n.label.toUpperCase();

        // Paint the page color behind the text so a label crossing a link
        // stays readable without a box or a halo around it.
        ctx.fillStyle = colors.bg;
        ctx.fillRect(p.rect.x - 2, p.rect.y - 1, p.rect.w + 4, p.rect.h + 2);

        // The label carries the node's colour too — on a graph this size the
        // dot alone is too small to read a category off.
        ctx.font = item ? `600 13px ${SERIF}` : `500 9.5px ${SANS}`;
        ctx.fillStyle = withAlpha(hue(n.hue), (item ? 1 : 0.9) * fade);
        ctx.textAlign = p.align;
        ctx.textBaseline = 'top';
        ctx.fillText(text, p.tx, p.rect.y);
      }
    }

    const ctx = fitCanvas(canvas, () => draw());

    function run() {
      cancelAnimationFrame(anim);
      const tick = () => {
        if (alpha > 0.02 || drag >= 0) {
          step();
          draw();
          anim = requestAnimationFrame(tick);
        } else {
          draw();
        }
      };
      anim = requestAnimationFrame(tick);
      cleanups.push(() => cancelAnimationFrame(anim));
    }

    function pick(ev: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      const px = ev.clientX - rect.left;
      const py = ev.clientY - rect.top;
      let best = -1;
      let bestD = 22 * 22;
      for (let i = 0; i < nodes.length; i++) {
        const dx = px - (nodes[i].x * view.s + view.ox);
        const dy = py - (nodes[i].y * view.s + view.oy);
        const d = dx * dx + dy * dy;
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      }
      return { i: best, px, py };
    }

    let downAt = 0;
    let moved = 0;

    /** Give up the current drag without treating it as a click. */
    function endDrag(e?: PointerEvent) {
      if (drag < 0) return;
      nodes[drag].pinned = false;
      drag = -1;
      canvas!.classList.remove('is-grabbing');
      if (e && canvas!.hasPointerCapture(e.pointerId)) canvas!.releasePointerCapture(e.pointerId);
      run();
    }

    on(canvas, 'pointermove', (e) => {
      const { i, px, py } = pick(e);
      if (drag >= 0) {
        moved++;
        nodes[drag].x = (px - view.ox) / view.s;
        nodes[drag].y = (py - view.oy) / view.s;
        alpha = Math.max(alpha, 0.12);
        return;
      }
      // Touch has no hover; isolation there is by tap, in pointerup.
      if (e.pointerType !== 'mouse') return;
      if (i !== hover) {
        hover = i;
        if (alpha <= 0.02) draw();
      }
    });
    on(canvas, 'pointerdown', (e) => {
      const { i } = pick(e);
      if (i < 0) {
        if (e.pointerType !== 'mouse' && hover !== -1) {
          hover = -1;
          draw();
        }
        return;
      }
      drag = i;
      moved = 0;
      downAt = performance.now();
      nodes[i].pinned = true;
      canvas.classList.add('is-grabbing');
      canvas.setPointerCapture(e.pointerId);
      alpha = Math.max(alpha, 0.3);
      run();
    });
    on(canvas, 'pointerup', (e) => {
      if (drag < 0) return;
      const n = nodes[drag];
      const i = drag;
      const tapped = moved < 4 && performance.now() - downAt < 400;
      endDrag(e);
      if (!tapped) return;
      if (e.pointerType === 'mouse') {
        if (n.kind === 'item' && n.url) window.open(n.url, '_blank', 'noopener');
        return;
      }
      // Touch: tap to isolate, tap the isolated node again to follow its link.
      if (hover === i) {
        if (n.kind === 'item' && n.url) window.open(n.url, '_blank', 'noopener');
        return;
      }
      hover = i;
      draw();
    });
    // A touch the browser turns into a page scroll cancels rather than ends.
    on(canvas, 'pointercancel', (e) => endDrag(e));
    on(canvas, 'pointerleave', (e) => {
      // Mouse only: a touch pointer fires leave the instant the finger lifts,
      // which would clear the isolation the tap above just set.
      if (e.pointerType !== 'mouse') return;
      if (hover !== -1) {
        hover = -1;
        if (alpha <= 0.02) draw();
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-shelf-mode]').forEach((btn) => {
      on(btn, 'click', () => {
        document
          .querySelectorAll('[data-shelf-mode]')
          .forEach((b) => b.classList.toggle('is-on', b === btn));
        build(btn.dataset.shelfMode === 'sample' ? SAMPLE : real);
      });
    });

    onThemeChange(() => {
      colors = palette();
      // Both the node hues and the legend swatches are theme-dependent, and
      // the legend's are inline styles that nothing else would refresh.
      drawLegend(showing);
      draw();
    });

    build(real);
  }

  function teardown() {
    while (cleanups.length) cleanups.pop()!();
  }

  document.addEventListener('astro:page-load', initShelf);
  document.addEventListener('astro:before-swap', teardown);
</script>
