---
// DEV-ONLY dark-background picker. Renders a small panel to try candidate dark
// `--bg` values live and pick one. It injects a dark-mode-only override (never
// touches light mode) and remembers the choice in localStorage. Gated by
// import.meta.env.DEV in BaseLayout, so it is never part of the built site.
const options = [
  { hex: '#2E2A25', note: 'warm (original)' },
  { hex: '#2A2A2F', note: 'cool' },
  { hex: '#1E1E1C', note: '' },
  { hex: '#1C1C1B', note: '' },
  { hex: '#191A19', note: 'current' },
  { hex: '#1A1B1A', note: '' },
  { hex: '#151815', note: '' },
  { hex: '#131614', note: '' },
];
---

<div id="dark-bg-picker" data-hidden>
  <div class="dbp-head">
    <strong>Dark bg</strong>
    <button type="button" class="dbp-x" data-close aria-label="Hide">×</button>
  </div>
  <ul class="dbp-list">
    {
      options.map((o) => (
        <li>
          <button type="button" class="dbp-opt" data-bg={o.hex}>
            <span class="dbp-sw" style={`background:${o.hex}`} />
            <span class="dbp-hex">{o.hex}</span>
            {o.note && <span class="dbp-note">{o.note}</span>}
          </button>
        </li>
      ))
    }
  </ul>
  <button type="button" class="dbp-reset" data-reset>Clear override</button>
</div>

<script is:inline>
  (function () {
    if (window.__darkBgPickerBound) return;
    window.__darkBgPickerBound = true;
    var STYLE_ID = 'dev-dark-bg-override';
    var KEY = 'devDarkBg';

    function apply(hex) {
      var el = document.getElementById(STYLE_ID);
      if (!hex) {
        if (el) el.remove();
        return;
      }
      if (!el) {
        el = document.createElement('style');
        el.id = STYLE_ID;
        document.head.appendChild(el);
      }
      el.textContent =
        ":root[data-theme='dark']{--bg:" +
        hex +
        ' !important}@media (prefers-color-scheme: dark){:root:not([data-theme=\'light\']){--bg:' +
        hex +
        ' !important}}';
    }

    function markActive(hex) {
      document.querySelectorAll('#dark-bg-picker .dbp-opt').forEach(function (b) {
        b.toggleAttribute('data-on', b.getAttribute('data-bg') === hex);
      });
    }

    // Restore any saved choice up front.
    try {
      var saved = localStorage.getItem(KEY);
      if (saved) apply(saved);
    } catch (e) {}

    document.addEventListener('click', function (e) {
      var t = e.target;
      var opt = t && t.closest ? t.closest('#dark-bg-picker .dbp-opt') : null;
      if (opt) {
        var hex = opt.getAttribute('data-bg');
        // Force dark so the change is visible immediately.
        document.documentElement.setAttribute('data-theme', 'dark');
        try {
          localStorage.setItem('theme', 'dark');
          localStorage.setItem(KEY, hex);
        } catch (e2) {}
        apply(hex);
        markActive(hex);
        return;
      }
      if (t.closest && t.closest('#dark-bg-picker [data-reset]')) {
        try {
          localStorage.removeItem(KEY);
        } catch (e3) {}
        apply(null);
        markActive(null);
        return;
      }
      if (t.closest && t.closest('#dark-bg-picker [data-close]')) {
        var p = document.getElementById('dark-bg-picker');
        if (p) p.setAttribute('data-hidden', '');
        return;
      }
    });

    // Re-mark and re-show after view-transition navigations.
    function refresh() {
      var p = document.getElementById('dark-bg-picker');
      if (!p) return;
      p.removeAttribute('data-hidden');
      try {
        markActive(localStorage.getItem(KEY));
      } catch (e) {}
    }
    document.addEventListener('astro:page-load', refresh);
    refresh();
  })();
</script>

<style>
  #dark-bg-picker {
    position: fixed;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 3000;
    width: 12.5rem;
    padding: 0.6rem 0.7rem 0.7rem;
    border-radius: 12px;
    background: #fdfcf9;
    color: #1a1a18;
    border: 1px solid #d9d4c9;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.45);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
  }
  #dark-bg-picker[data-hidden] {
    display: none;
  }
  .dbp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
  }
  .dbp-x {
    border: none;
    background: none;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    color: #6b6960;
  }
  .dbp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dbp-opt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.3rem 0.35rem;
    border: 1px solid transparent;
    border-radius: 7px;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .dbp-opt:hover {
    background: #f0ede6;
  }
  .dbp-opt[data-on] {
    border-color: #1e7f75;
    background: #eff6f4;
  }
  .dbp-sw {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    flex: none;
  }
  .dbp-hex {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .dbp-note {
    margin-left: auto;
    color: #6b6960;
    font-style: italic;
  }
  .dbp-reset {
    margin-top: 0.5rem;
    width: 100%;
    padding: 0.35rem;
    border: 1px solid #d9d4c9;
    border-radius: 7px;
    background: #faf9f6;
    cursor: pointer;
    color: #6b6960;
    font-size: 0.7rem;
  }
</style>
