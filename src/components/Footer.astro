---
// Update these as needed.
const year = new Date().getFullYear();
const github = 'https://github.com/athreyashreyas';
const linkedin = 'https://www.linkedin.com/in/shreyasathreya/';
const email = 'athreya.shreyas@gmail.com';
const resume = 'https://athreyashreyas.github.io/resume/resume_latest.pdf';
---

<footer class="site-footer" transition:persist>
  <p class="line">
    <span>© {year} Shreyas Athreya</span>

    <span class="icons">
      <a class="icon-link" href={github} rel="me" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </a>

      <a class="icon-link" href={linkedin} rel="me" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>

      <a
        class="icon-link"
        href={resume}
        target="_blank"
        rel="noopener"
        aria-label="Résumé (PDF, opens in a new tab)"
        title="Résumé (PDF)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM7.5 15a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 7.5 15Zm.75 2.25a.75.75 0 0 0 0 1.5H12a.75.75 0 0 0 0-1.5H8.25Z"
            clip-rule="evenodd"
          />
          <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
        </svg>
      </a>

      <a class="icon-link" href={`mailto:${email}`} aria-label="Email" title="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
          <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
        </svg>
      </a>
    </span>
  </p>
</footer>

<style>
  .site-footer {
    font-family: var(--font-sans);
    border-top: 1px solid var(--border);
    padding-block: 1.75rem 2.5rem;
    margin-top: 4rem;
  }

  .line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .icons {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* padding enlarges the tap target (~30px) without spreading the icons */
    padding: 0.35rem;
    color: var(--text-secondary);
    line-height: 0;
    transition:
      color 0.2s ease,
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .icon-link svg {
    width: 1.2rem;
    height: 1.2rem;
    display: block;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    color: var(--accent-link);
    transform: translateY(-1px);
    /* Glow in the chosen green. */
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--accent-link) 75%, transparent))
      drop-shadow(0 0 12px color-mix(in srgb, var(--accent-link) 45%, transparent));
  }
</style>
