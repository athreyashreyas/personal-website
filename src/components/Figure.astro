---
// A plain captioned image, sized to the prose measure. Deliberately NOT
// astro:assets — these files are pre-optimised and live in /public/images,
// which is the convention Keystatic writes into.
interface Props {
  src: string;
  srcset?: string;
  sizes?: string;
  alt: string;
  /** Plain-text caption. For a caption with a link, pass a `caption` slot. */
  caption?: string;
  width: number;
  height: number;
  /**
   * Discourage casual saving: blocks drag-to-desktop, right-click, and the
   * iOS long-press sheet. A deterrent only — the file is still at a public
   * URL and reachable from devtools or the network tab.
   */
  protect?: boolean;
}

const {
  src,
  srcset,
  sizes = '(max-width: 640px) 100vw, min(65ch, 100vw)',
  alt,
  caption,
  width,
  height,
  protect = false,
} = Astro.props;

const hasCaptionSlot = Astro.slots.has('caption');
---

<figure class="figure" class:list={[{ 'is-protected': protect }]}>
  <img
    src={src}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    draggable={protect ? 'false' : undefined}
  />
  {
    (hasCaptionSlot || caption) && (
      <figcaption>{hasCaptionSlot ? <slot name="caption" /> : caption}</figcaption>
    )
  }
</figure>

{/* Without JS the reveal script below never runs, so the image would stay at
    opacity: 0 forever — force it visible in that case.

    !important is doing real work here, not papering over anything: Astro
    scopes the rule below to `.figure[data-astro-cid-…] img[data-astro-cid-…]`,
    which out-specifies the plain `.figure img` this can use, so without it the
    fallback never applies and a no-JS reader sees nothing at all. Nothing else
    competes for opacity here, and this only ever renders with JS off. */}
<noscript>
  <style>
    .figure img {
      opacity: 1 !important;
    }
  </style>
</noscript>

<style>
  .figure {
    /* Aligns to the prose column above it; the parent's own max-width wins
       when it's narrower, so the left edges always agree. */
    width: 100%;
    max-width: var(--measure);
    margin: 3rem 0 0;
  }

  .figure img {
    width: 100%;
    /* Reserve the box before the bytes arrive — no layout shift on load. */
    aspect-ratio: 3 / 2;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    /* Fades in on decode instead of popping in — a big high-contrast photo
       appearing instantly against the paper background reads as a flash
       even on a fast connection. The reveal script below toggles .is-loaded
       once the image has actually decoded (or immediately, if it was already
       cached/complete by the time the script runs). Duration matches the
       theme-switch transition (see global.css) so the two feel like one
       motion language rather than two different speeds. */
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .figure img {
      transition: opacity 0.22s ease;
    }
  }

  .figure img.is-loaded {
    opacity: 1;
  }

  /* Deterrents against casual saving. Scoped to this image only — the rest of
     the page keeps normal selection and context-menu behaviour. */
  .figure.is-protected img {
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    /* Suppresses the iOS long-press "Save Image" sheet. */
    -webkit-touch-callout: none;
  }

  .figure figcaption {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-top: 0.75rem;
    /* Centred on the image, which the figcaption matches in width. Balanced so
       a wrapped caption splits evenly instead of orphaning a word on phones. */
    text-align: center;
    text-wrap: balance;
  }
</style>

{/* Right-click guard for protected figures. Delegated at the document and
    bound once, so it survives view-transition navigations (same pattern as
    the BaseLayout scripts). Inert on unprotected figures. */}
<script is:inline>
  (function () {
    if (window.__figureProtectBound) return;
    window.__figureProtectBound = true;
    document.addEventListener('contextmenu', function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('.figure.is-protected')) e.preventDefault();
    });
  })();
</script>

{/* Fade-in reveal. Each Figure gets fresh <img> DOM on every navigation (the
    component isn't transition:persist'd), so re-running this on every
    astro:page-load is correct, not a re-bind risk — no "bound once" guard
    needed here, unlike the delegated listener above. Runs once immediately
    too, matching the dual-call pattern BaseLayout uses for nav-current,
    in case astro:page-load already fired before this executes. */}
<script is:inline>
  (function () {
    function reveal(img) {
      img.classList.add('is-loaded');
    }
    function wireFigureReveal() {
      document.querySelectorAll('.figure img:not(.is-loaded)').forEach(function (img) {
        if (img.complete && img.naturalWidth > 0) {
          reveal(img);
          return;
        }
        img.addEventListener('load', function () { reveal(img); }, { once: true });
        // A broken image would otherwise stay at opacity 0 forever, hiding the
        // alt text that's meant to stand in for it.
        img.addEventListener('error', function () { reveal(img); }, { once: true });
      });
    }
    document.addEventListener('astro:page-load', wireFigureReveal);
    wireFigureReveal();
  })();
</script>
