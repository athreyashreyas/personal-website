---
// Glowing icon links for a project: the live site (external-link icon) and the
// source repo (GitHub icon). Same hover glow as the footer's social icons.
// Renders nothing when both links are absent.
interface Props {
  links: { repo?: string; live?: string };
}
const { links } = Astro.props;
---

{
  (links.live || links.repo) && (
    <span class="project-links">
      {links.live && (
        <a
          class="icon-link"
          href={links.live}
          target="_blank"
          rel="noopener"
          aria-label="Live site (opens in a new tab)"
          title="Live site"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M14 3a1 1 0 0 0 0 2h3.586l-8.293 8.293a1 1 0 1 0 1.414 1.414L19 6.414V10a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-6Z" />
            <path d="M5 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 1 0-2 0v5H5V7h5a1 1 0 0 0 0-2H5Z" />
          </svg>
        </a>
      )}
      {links.repo && (
        <a
          class="icon-link"
          href={links.repo}
          target="_blank"
          rel="noopener"
          aria-label="Source code on GitHub (opens in a new tab)"
          title="Code"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </a>
      )}
    </span>
  )
}

<style>
  .project-links {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* padding enlarges the tap target without spreading the icons */
    padding: 0.3rem;
    color: var(--text-secondary);
    line-height: 0;
    transition:
      color 0.2s ease,
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .icon-link svg {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    color: var(--accent-link);
    transform: translateY(-1px);
    /* Glow in the chosen green, matching the footer. */
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--accent-link) 75%, transparent))
      drop-shadow(0 0 12px color-mix(in srgb, var(--accent-link) 45%, transparent));
  }
</style>
