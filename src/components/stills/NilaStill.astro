---
// Nila — the cycle home, reconstructed from src/components/ui/PhaseRing.tsx: a
// single ring in the CURRENT phase's colour, filled by how far through the cycle
// you are, a marker dot at today, and the day-in-phase at the centre. All of it
// is computed on-device from encrypted data. Dialled down for the blog.
import StillFrame from './StillFrame.astro';

const SIZE = 190;
const STROKE = 13;
const R = (SIZE - STROKE) / 2;
const C = SIZE / 2;
const CIRC = 2 * Math.PI * R;
const phaseColor = '#6a4aa0'; // luteal
const progress = 18 / 28; // cycle day / length
const dashOffset = CIRC * (1 - progress);
const ang = (progress * 360 - 90) * (Math.PI / 180);
const dotX = C + R * Math.cos(ang);
const dotY = C + R * Math.sin(ang);
---

<StillFrame variant="phone" label="Home: where you are in the cycle, worked out on the device, never on a server">
  <div class="nla">
    <header class="nla-head">
      <h3 class="nla-title">Nila</h3>
      <span class="nla-lock">🔒 encrypted</span>
    </header>

    <div class="nla-ring-wrap">
      <svg class="nla-ring" viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-label="Cycle ring">
        <circle cx={C} cy={C} r={R} fill="none" stroke="#e0dcd2" stroke-width={STROKE} />
        <circle
          cx={C}
          cy={C}
          r={R}
          fill="none"
          stroke={phaseColor}
          stroke-width={STROKE}
          stroke-linecap="round"
          stroke-dasharray={CIRC}
          stroke-dashoffset={dashOffset}
          transform={`rotate(-90 ${C} ${C})`}
        />
        <circle cx={dotX} cy={dotY} r={STROKE / 2 + 1} fill={phaseColor} />
      </svg>
      <div class="nla-ring-mid">
        <span class="nla-day" style={`color:${phaseColor}`}>4</span>
        <span class="nla-day-l">day</span>
      </div>
    </div>

    <p class="nla-phase" style={`color:${phaseColor}`}>Luteal phase</p>
    <p class="nla-predict">Period expected in about 9 days</p>

    <div class="nla-insight">
      <p class="nla-insight-k">Pattern</p>
      <p class="nla-insight-t">You tend to log cramps in your luteal phase.</p>
    </div>
  </div>
</StillFrame>

<style>
  .nla {
    background: #faf9f6;
    color: #1a1a18;
    padding: 18px 16px 20px;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .nla-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nla-title {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 22px;
  }
  .nla-lock {
    font-size: 10px;
    letter-spacing: 0.02em;
    color: #8e3b5c;
    background: rgba(142, 59, 92, 0.13);
    padding: 3px 9px;
    border-radius: 999px;
  }

  .nla-ring-wrap {
    position: relative;
    width: 190px;
    height: 190px;
    margin: 12px auto 4px;
  }
  .nla-ring {
    width: 100%;
    height: 100%;
  }
  .nla-ring-mid {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .nla-day {
    font-family: Georgia, serif;
    font-size: 46px;
    line-height: 1;
  }
  .nla-day-l {
    font-size: 12px;
    color: #6b6960;
    margin-top: 2px;
  }
  .nla-phase {
    margin: 6px 0 0;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
  }
  .nla-predict {
    margin: 3px 0 0;
    text-align: center;
    font-size: 12px;
    color: #6b6960;
  }

  .nla-insight {
    margin: 15px 0 0;
    background: #fdfcf9;
    border: 1px solid #f0ede6;
    border-left: 3px solid #8e3b5c;
    border-radius: 10px;
    padding: 10px 12px;
  }
  .nla-insight-k {
    margin: 0;
    font-size: 9.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #8e3b5c;
  }
  .nla-insight-t {
    margin: 3px 0 0;
    font-size: 12.5px;
    color: #3d3d38;
  }
</style>
