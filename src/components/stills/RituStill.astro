---
// Ritu Sharma Art — a real screenshot of the live gallery (the /artworks page),
// captured from ritu-sharma-art.vercel.app and framed as a browser window. Real
// paintings, real filter bar, rather than a reconstruction.
import StillFrame from './StillFrame.astro';
---

<StillFrame
  variant="browser"
  url="ritu-sharma-art.vercel.app/artworks"
  label="The gallery: filterable by medium, price and availability, all hers to populate and run"
  protect
>
  <img
    class="ritu-shot"
    src="/project-shots/ritu-gallery.jpg"
    width="1600"
    height="1250"
    loading="lazy"
    alt="The Ritu Sharma Art portfolio page: a filter bar over a masonry grid of original paintings."
  />
</StillFrame>

<style>
  .ritu-shot {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
