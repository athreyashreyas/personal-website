---
// Attend — the real Dashboard, reconstructed from src/pages/DashboardPage.tsx +
// CourseCard.tsx: the sage "mark today" banner, semester filter tabs, and one
// card per class (colour bar, projection badge, ProgressRing). Dialled down.
import StillFrame from './StillFrame.astro';

const courses = [
  { name: 'Data Structures', bar: '#1e7f75', pct: 92, tone: 'green', badge: 'Can miss 3 of 8 left' },
  { name: 'Pottery', bar: '#c98f3e', pct: 78, tone: 'amber', badge: 'Attend all 4 left' },
  { name: 'French A2', bar: '#b85c72', pct: 71, tone: 'rose', badge: 'Below 75%' },
];
const ringColor: Record<string, string> = { green: '#4f7942', amber: '#c98f3e', rose: '#b85c72' };
const badgeBg: Record<string, string> = { green: '#e8f0e6', amber: '#f5e9d6', rose: '#f3e2e6' };
const badgeFg: Record<string, string> = { green: '#2d4a2e', amber: '#8a5a1c', rose: '#8f3547' };
---

<StillFrame variant="phone" label="Dashboard: every class, with how much room you have left">
  <div class="atd">
    <header class="atd-head">
      <h3 class="atd-title">Attend</h3>
      <p class="atd-sub">All classes</p>
    </header>

    <div class="atd-tabs">
      <span class="atd-t atd-t--on">All</span>
      <span class="atd-t">Spring '25</span>
      <span class="atd-t">Standalone</span>
    </div>

    <a class="atd-banner">
      <span class="atd-banner-ic">✓</span>
      <span class="atd-banner-txt">
        <b>Mark today's classes</b>
        <span>2 classes left to mark today</span>
      </span>
      <span class="atd-banner-arrow">→</span>
    </a>

    <div class="atd-cards">
      {
        courses.map((c) => (
          <div class="atd-card">
            <span class="atd-bar" style={`background:${c.bar}`} />
            <div class="atd-card-body">
              <p class="atd-card-name">{c.name}</p>
              <span class="atd-badge" style={`background:${badgeBg[c.tone]};color:${badgeFg[c.tone]}`}>
                {c.badge}
              </span>
            </div>
            <svg class="atd-ring" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="28" fill="none" stroke="#e0dcd2" stroke-width="6" />
              <circle
                cx="32"
                cy="32"
                r="28"
                fill="none"
                stroke={ringColor[c.tone]}
                stroke-width="6"
                pathLength="100"
                stroke-dasharray={`${c.pct} 100`}
                stroke-linecap="round"
                transform="rotate(-90 32 32)"
              />
              <text x="32" y="37" text-anchor="middle" class="atd-ring-t">{c.pct}%</text>
            </svg>
          </div>
        ))
      }
    </div>
  </div>
</StillFrame>

<style>
  .atd {
    background: #faf9f6;
    color: #1a1a18;
    padding: 16px 15px 18px;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .atd-head {
    margin-bottom: 12px;
  }
  .atd-title {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 22px;
  }
  .atd-sub {
    margin: 1px 0 0;
    font-size: 11.5px;
    color: #6b6960;
  }

  .atd-tabs {
    display: flex;
    gap: 7px;
    margin-bottom: 13px;
  }
  .atd-t {
    font-size: 11px;
    color: #6b6960;
    background: #f0ede6;
    padding: 4px 11px;
    border-radius: 999px;
  }
  .atd-t--on {
    background: #4f7942;
    color: #f3f7f2;
  }

  .atd-banner {
    display: flex;
    align-items: center;
    gap: 11px;
    background: #4f7942;
    color: #fff;
    border-radius: 12px;
    padding: 12px 13px;
    box-shadow: 0 6px 14px -6px rgba(45, 74, 46, 0.55);
  }
  .atd-banner-ic {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    font-size: 13px;
  }
  .atd-banner-txt {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .atd-banner-txt b {
    font-size: 13px;
    font-weight: 600;
  }
  .atd-banner-txt span {
    font-size: 11px;
    color: #f3f7f2;
    opacity: 0.9;
  }
  .atd-banner-arrow {
    font-family: Georgia, serif;
    font-size: 20px;
  }

  .atd-cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
  }
  .atd-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fdfcf9;
    border: 1px solid #f0ede6;
    border-radius: 12px;
    padding: 11px 12px;
    box-shadow: 0 3px 8px -5px rgba(35, 25, 15, 0.1);
  }
  .atd-bar {
    width: 5px;
    height: 42px;
    border-radius: 999px;
    flex: none;
  }
  .atd-card-body {
    flex: 1;
    min-width: 0;
  }
  .atd-card-name {
    margin: 0 0 5px;
    font-size: 13.5px;
    font-weight: 600;
    color: #1a1a18;
  }
  .atd-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 2.5px 7px;
    border-radius: 999px;
  }
  .atd-ring {
    width: 46px;
    height: 46px;
    flex: none;
  }
  .atd-ring-t {
    font-family: system-ui, sans-serif;
    font-size: 15px;
    font-weight: 700;
    fill: #1a1a18;
  }
</style>
