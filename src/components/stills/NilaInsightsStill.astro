---
// Nila — the Insights screen, reconstructed from src/app/(app)/insights/page.tsx,
// src/lib/insights/reflection.ts and src/lib/recommendations/data.ts. The
// reflection line below is composited from reflection.ts's actual phrase pools
// (opener + a symptom observation + closer) for the pictured state: luteal
// phase, "cramps" logged today. The food list reproduces the real symptom-boost
// behaviour — logging cramps promotes Dark chocolate and Chamomile tea (both on
// cramps' priority list) to the top and tags the first as "top pick", ahead of
// Sweet potato, luteal's next default. Dialled down for the blog.
import StillFrame from './StillFrame.astro';

const phaseColor = '#6a4aa0'; // luteal, same moment as NilaStill/NilaCheckinStill

const stats = [
  { label: 'Avg cycle', value: '29d', sub: 'high confidence' },
  { label: 'Avg period', value: '5d', sub: '6 cycles logged' },
  { label: 'Next in', value: '9d', sub: '±2d' },
];

const foods = [
  { emoji: '🍫', name: 'Dark chocolate', reason: 'Magnesium and mood support in one', top: true },
  { emoji: '🌼', name: 'Chamomile tea', reason: 'Calms the nervous system as it winds down' },
  { emoji: '🍠', name: 'Sweet potato', reason: 'Complex carbs ease progesterone-driven cravings' },
];

const avoid = ['Excess caffeine', 'Alcohol', 'Very salty foods'];
---

<StillFrame variant="phone" label="Insights: a reflective read on your rhythm, plus food suggestions tuned to your phase and today's symptoms">
  <div class="nin">
    <header class="nin-head">
      <h3 class="nin-title">Your rhythm</h3>
    </header>

    <div class="nin-stats">
      {stats.map((s) => (
        <div class="nin-stat">
          <span class="nin-stat-v">{s.value}</span>
          <span class="nin-stat-l">{s.label}</span>
          <span class="nin-stat-s">{s.sub}</span>
        </div>
      ))}
    </div>

    <div class="nin-card">
      <p class="nin-card-k">A note on your rhythm</p>
      <p class="nin-reflect">
        You are in your luteal phase, when it is normal to want to turn inward.
        Cramps has come up 3 times recently, so it is worth being gentle with
        yourself when it arrives.
      </p>
    </div>

    <div class="nin-card">
      <div class="nin-food-head">
        <span class="nin-food-headline">Steady and grounding</span>
        <span class="nin-phase-badge" style={`background:${phaseColor}22;color:${phaseColor}`}>Luteal</span>
      </div>
      <p class="nin-trigger" style={`color:${phaseColor}`}>Personalised for: cramps</p>

      {foods.map((f) => (
        <div class="nin-food">
          <span class="nin-food-emoji">{f.emoji}</span>
          <div class="nin-food-body">
            <div class="nin-food-name-row">
              <span class="nin-food-name">{f.name}</span>
              {f.top && <span class="nin-top-pick" style={`background:${phaseColor}22;color:${phaseColor}`}>top pick</span>}
            </div>
            <p class="nin-food-reason">{f.reason}</p>
          </div>
        </div>
      ))}

      <p class="nin-lifestyle">Honour the slower pace. Gentle yoga and creative work thrive here.</p>

      <p class="nin-avoid-k">Go easy on</p>
      <div class="nin-avoid">
        {avoid.map((a) => <span class="nin-avoid-chip">{a}</span>)}
      </div>
    </div>
  </div>
</StillFrame>

<style>
  .nin {
    background: #faf9f6;
    color: #1a1a18;
    padding: 18px 16px 20px;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .nin-title {
    margin: 0 0 12px;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 22px;
    /* Restated so the page's global h3 colour can't reach in. */
    color: inherit;
  }

  .nin-stats {
    display: flex;
    gap: 7px;
    margin-bottom: 12px;
  }
  .nin-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #fdfcf9;
    border-radius: 10px;
    padding: 8px 4px;
    box-shadow: 0 1px 2px rgba(26, 26, 24, 0.05), 0 3px 10px rgba(26, 26, 24, 0.06);
  }
  .nin-stat-v {
    font-family: Georgia, serif;
    font-size: 19px;
    color: #8e3b5c;
    line-height: 1;
  }
  .nin-stat-l {
    font-size: 9px;
    font-weight: 600;
    margin-top: 4px;
  }
  .nin-stat-s {
    font-size: 8px;
    opacity: 0.5;
    margin-top: 1px;
  }

  .nin-card {
    background: #fdfcf9;
    border-radius: 12px;
    padding: 12px 13px;
    margin-bottom: 10px;
    box-shadow: 0 1px 2px rgba(26, 26, 24, 0.05), 0 3px 10px rgba(26, 26, 24, 0.06);
  }
  .nin-card-k {
    margin: 0 0 6px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #8e3b5c;
  }
  .nin-reflect {
    margin: 0;
    font-family: Georgia, serif;
    font-size: 13.5px;
    line-height: 1.42;
  }

  .nin-food-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 6px;
  }
  .nin-food-headline {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #6b6960;
  }
  .nin-phase-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .nin-trigger {
    font-size: 10px;
    font-weight: 600;
    margin: 0 0 10px;
  }

  .nin-food {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-bottom: 9px;
  }
  .nin-food-emoji {
    font-size: 17px;
    line-height: 1;
    margin-top: 1px;
  }
  .nin-food-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nin-food-name {
    font-size: 13px;
    font-weight: 600;
  }
  .nin-top-pick {
    font-size: 8.5px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 999px;
  }
  .nin-food-reason {
    margin: 1px 0 0;
    font-size: 11px;
    line-height: 1.3;
    color: #6b6960;
  }

  .nin-lifestyle {
    margin: 2px 0 10px;
    font-size: 11.5px;
    line-height: 1.4;
    background: rgba(142, 59, 92, 0.08);
    border-radius: 8px;
    padding: 8px 10px;
  }

  .nin-avoid-k {
    margin: 0 0 5px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b6960;
  }
  .nin-avoid {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .nin-avoid-chip {
    font-size: 10px;
    color: #3d3d38;
    background: #f0ede6;
    padding: 4px 9px;
    border-radius: 999px;
    opacity: 0.75;
  }
</style>
