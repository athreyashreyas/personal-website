---
// Harmony — the real Bloom home, reconstructed from src/components/Bloom/Bloom.tsx
// + HomeScreen.tsx. Each petal is a donut-segment wedge (inner radius 22, outer
// 80) that fills outward with how tended its area of life is. Dialled down.
import StillFrame from './StillFrame.astro';

const SIZE = 220,
  C = 110,
  MIN = 22,
  MAX = 80,
  GAP = 4;

const areas = [
  { name: 'Movement', color: '#b5532f', activity: 1.0 },
  { name: 'Mind', color: '#c98f3e', activity: 0.72 },
  { name: 'Craft', color: '#47602a', activity: 0.9 },
  { name: 'Rest', color: '#5b6b7a', activity: 0.5 },
  { name: 'People', color: '#7a5a8a', activity: 0.82 },
  { name: 'Money', color: '#b85c72', activity: 0.4 },
];
const slice = 360 / areas.length;

function pt(r: number, deg: number) {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
}
function seg(ri: number, ro: number, a0: number, a1: number) {
  const [x0o, y0o] = pt(ro, a0);
  const [x1o, y1o] = pt(ro, a1);
  const [x1i, y1i] = pt(ri, a1);
  const [x0i, y0i] = pt(ri, a0);
  const large = a1 - a0 > 180 ? 1 : 0;
  return `M${x0o} ${y0o} A${ro} ${ro} 0 ${large} 1 ${x1o} ${y1o} L${x1i} ${y1i} A${ri} ${ri} 0 ${large} 0 ${x0i} ${y0i} Z`;
}
const petals = areas.map((a, i) => {
  const a0 = i * slice + GAP / 2;
  const a1 = (i + 1) * slice - GAP / 2;
  return {
    ...a,
    track: seg(MIN, MAX, a0, a1),
    fill: seg(MIN, MIN + (MAX - MIN) * a.activity, a0, a1),
  };
});
---

<StillFrame variant="phone" label="The Bloom: your whole week as one flower, one petal per area of life">
  <div class="hmy">
    <p class="hmy-date">Friday, 28 July</p>
    <h3 class="hmy-greet">Good evening.</h3>

    <svg class="hmy-bloom" viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-label="A bloom of six petals">
      {
        petals.map((p) => (
          <>
            <path d={p.track} fill={p.color} fill-opacity="0.13" />
            <path d={p.fill} fill={p.color} fill-opacity="0.87" />
          </>
        ))
      }
      <circle cx={C} cy={C} r="20" fill="#fbf1e4" />
      <circle cx={C} cy={C} r="20" fill="#b5532f" fill-opacity="0.08" />
    </svg>

    <div class="hmy-chips">
      {
        areas.slice(0, 4).map((a) => (
          <span class="hmy-chip">
            <span class="hmy-chip-dot" style={`background:${a.color}`} />
            {a.name}
          </span>
        ))
      }
    </div>

    <p class="hmy-note">A few areas waiting for you.</p>
  </div>
</StillFrame>

<style>
  .hmy {
    background: #fffaf1;
    color: #23190f;
    padding: 18px 16px 20px;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .hmy-date {
    margin: 0;
    font-size: 12px;
    color: #ab977a;
  }
  .hmy-greet {
    margin: 2px 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 23px;
    color: #23190f;
  }
  .hmy-bloom {
    display: block;
    width: 205px;
    height: 205px;
    margin: 8px auto 2px;
  }
  .hmy-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .hmy-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #76654c;
    background: #fbf1e4;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .hmy-chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .hmy-note {
    margin: 13px 0 0;
    text-align: center;
    font-size: 12px;
    color: #ab977a;
  }
</style>
