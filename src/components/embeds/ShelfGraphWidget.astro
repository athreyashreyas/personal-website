---
/**
 * "The shelf" — everything on the recommendations page drawn as a graph.
 * Entries are the large nodes, coloured by category; the tags they share are
 * the small ones. Nothing about the shape is authored: it's a force layout over
 * whatever the collection happens to contain, so books that share a tag pull
 * together on their own.
 *
 * Data rides on a data attribute rather than a JSON <scr!pt> — Vite's dependency
 * scanner parses script tags as JavaScript and chokes on JSON.
 */
import { shelfItems } from '../../lib/shelf';

const items = await shelfItems();
---

<figure class="sg" data-shelf>
  <div class="sg-controls">
    <output class="sg-readout" data-shelf-readout></output>

    {/* Pinch and ctrl-wheel are the fast paths, but neither is available to a
        keyboard and neither is discoverable. These are the guaranteed one. */}
    <span class="sg-zoom">
      <button type="button" class="sg-btn" data-shelf-zoom="out" aria-label="Zoom out">
        &minus;
      </button>
      <output class="sg-level" data-shelf-level aria-live="off">100%</output>
      <button type="button" class="sg-btn" data-shelf-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" class="sg-btn sg-btn--wide" data-shelf-zoom="reset" hidden>
        Reset
      </button>
    </span>
  </div>
  {/* A decorative re-presentation of the recommendations list, which is itself
      on /recommendations as text. role=img with a name keeps a screen reader
      from announcing an empty canvas, without pretending the graph is
      navigable. */}
  <canvas
    class="sg-canvas"
    role="img"
    aria-label={`A graph of ${items.length} recommendations and the tags they share. The same entries are listed as text on the recommendations page.`}
    data-shelf-canvas
    data-shelf-items={JSON.stringify(items)}></canvas>
  <ul class="sg-legend" data-shelf-legend></ul>
  <figcaption class="sg-note">
    Pinch or ⌘/Ctrl-scroll to zoom in on a corner — titles grow and crowded ones
    reappear as the graph opens up. Drag the background to move around, drag a
    node to pull the rest along. On a mouse, hover a node to isolate what it
    touches and click an entry to open it; on a touchscreen, tap a node to
    isolate it and tap it again to open.
  </figcaption>
</figure>

<style>
  .sg {
    margin: 2rem 0;
    padding: 0;
  }

  .sg-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
    font-family: var(--font-sans);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    color: var(--text-secondary);
  }
  .sg-readout {
    font-variant-numeric: tabular-nums;
  }

  /* Pushed to the far end of the control bar, away from the readout. */
  .sg-zoom {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
  }
  .sg-level {
    min-width: 3.4em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .sg-btn {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    /* A real touch target — these are the fallback for anyone who can't pinch. */
    min-width: 2rem;
    min-height: 2rem;
    cursor: pointer;
  }
  .sg-btn--wide {
    min-width: auto;
    padding: 0 0.6em;
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
  }
  .sg-btn[hidden] {
    display: none;
  }
  .sg-btn:hover:not(:disabled) {
    color: var(--accent-link);
    border-color: var(--accent-link);
  }
  .sg-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .sg-canvas {
    display: block;
    width: 100%;
    height: 460px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    /* pan-y, not none: `none` meant a finger starting anywhere on the canvas
       never scrolled the page, so on a phone this 400px block trapped the
       reader inside it. Vertical scrolling now passes through, while
       horizontal movement still reaches the drag handler. The browser cancels
       the pointer when it takes over the scroll — see the pointercancel
       handler, without which the node stays stuck to the finger. */
    touch-action: pan-y;
    cursor: grab;
  }
  .sg-canvas.is-grabbing {
    cursor: grabbing;
  }

  /* Rows are built in JS from whichever categories the collection contains, so
     they never carry the scoping attribute — these have to be :global. */
  .sg-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--label-size);
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    color: var(--text-secondary);
  }
  .sg-legend :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .sg-legend :global(.sg-swatch) {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }
  .sg-legend :global(li.is-tag .sg-swatch) {
    width: 0.42em;
    height: 0.42em;
  }

  .sg-note {
    margin: 0.8rem auto 0;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-secondary);
    text-align: center;
  }

  /* Taller rather than shorter on a phone. The canvas is much narrower here,
     so the layout has to stack vertically, and label placement gives up on any
     label it can't fit without overlapping — height is what buys those back. */
  @media (max-width: 720px) {
    .sg-canvas {
      height: 460px;
    }
  }
</style>

<script>
  const SANS = "'Plus Jakarta Sans', system-ui, sans-serif";
  const SERIF = "'Newsreader', Georgia, serif";

  /** Label type, a step larger on a narrow canvas. 9.5px tag labels are close
      to unreadable on a phone held at arm's length; the extra width a bigger
      label costs is worth less there than being able to read it at all. */
  const baseLabelSize = (item: boolean, w: number) =>
    item ? (w < 560 ? 14 : 13) : w < 560 ? 11 : 9.5;

  /**
   * How much bigger labels get as the reader zooms in.
   *
   * Deliberately sub-linear and capped. Scaling text with the zoom outright
   * would make a title 8× its size at maximum zoom — unreadably large, and it
   * would crowd out its neighbours exactly when the reader is trying to
   * separate them. The nodes themselves spread apart at the full rate, so a
   * gentle growth curve still leaves far more room per label than at 1×: the
   * overlap solver drops fewer of them, which is what actually makes titles
   * appear as you zoom.
   */
  const labelScale = (zoom: number) => Math.min(1.75, Math.pow(zoom, 0.42));

  /**
   * Trim `text` to fit `maxW`, with an ellipsis.
   *
   * Zooming scales labels up, and past a point a long title is simply wider
   * than the canvas — every candidate slot fails its bounds check and the
   * label is dropped, so the entry the reader zoomed in to read is the one
   * with no name on it. Truncating keeps it legible and identifiable; the full
   * title is a hover or a tap away, and on the recommendations page in full.
   */
  function fitText(ctx: CanvasRenderingContext2D, text: string, maxW: number) {
    if (ctx.measureText(text).width <= maxW) return text;
    let lo = 0;
    let hi = text.length;
    while (lo < hi) {
      const mid = (lo + hi + 1) >> 1;
      if (ctx.measureText(text.slice(0, mid) + '…').width <= maxW) lo = mid;
      else hi = mid - 1;
    }
    return lo > 0 ? text.slice(0, lo).trimEnd() + '…' : text.slice(0, 1) + '…';
  }

  /** Used by both the measuring pass and the paint pass, which must agree or
      the placement boxes stop matching the text drawn into them. */
  const labelFont = (item: boolean, w: number, zoom: number) => {
    const px = baseLabelSize(item, w) * labelScale(zoom);
    return item ? `600 ${px}px ${SERIF}` : `500 ${px}px ${SANS}`;
  };

  /** One hue per kind of entry, so a book and a newsletter don't read as the
      same thing. Desaturated and warm enough to sit on the paper background —
      the site's own two greens are only two values, which isn't enough to carry
      a categorical scale. Each pair is [light theme, dark theme]; the dark
      values are lifted, since the light ones go muddy on charcoal. `tag` is
      deliberately the odd one out: neutral, so tags read as the connective
      tissue between entries rather than as content. */
  const HUES: Record<string, [string, string]> = {
    book: ['#2F7D5F', '#7FCBA9'],
    essay: ['#B4552F', '#E08A5F'],
    newsletter: ['#8A5FA0', '#C09AD4'],
    link: ['#3E7191', '#8CB8D6'],
    // Terracotta, deliberately not another blue: `link` already holds that end
    // of the scale, and a whole site is a different thing from a single page.
    // Warm clay also reads against the green entries the way the site's own
    // paper does, rather than competing with them.
    website: ['#A25F3E', '#E0A07E'],
    talk: ['#A07A22', '#DCB65F'],
    film: ['#A24A6B', '#D690A8'],
    tag: ['#8C8578', '#9C958A'],
    other: ['#5C7A6B', '#93B3A2'],
  };

  type Item = { title: string; url: string | null; category: string | null; tags: string[] };
  type Node = {
    label: string;
    kind: 'item' | 'tag';
    hue: string;
    url: string | null;
    deg: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    pinned: boolean;
    /** Which candidate slot this label took last frame; -1 if it was dropped.
        Kept so placement is sticky rather than re-derived — see placeLabels. */
    slot: number;
  };
  type Rect = { x: number; y: number; w: number; h: number };

  type Cleanups = Array<() => void>;

  /**
   * The live widget on each element, keyed by its root, so a second
   * initialisation can shut the first one down.
   *
   * This used to be one module-level array shared by every instance, and
   * initShelf bailed out early when the root was already marked ready. Neither
   * actually stopped a second instance: each call to initShelf builds its own
   * closure with its own `nodes`, `alpha` and `anim`, so `run()`'s
   * cancelAnimationFrame reaches only the loop it started — never the previous
   * closure's. When anything re-ran init while a layout was still settling (an
   * HMR update in dev is the everyday case), two simulations ended up drawing
   * to the same canvas on alternating frames, and every label snapped between
   * two different layouts sixty times a second. That is the flicker.
   */
  const instances = new Map<HTMLElement, () => void>();

  function palette() {
    const cs = getComputedStyle(document.documentElement);
    const v = (n: string) => cs.getPropertyValue(n).trim();
    return {
      bg: v('--bg'),
      text: v('--text-primary'),
      dim: v('--text-secondary'),
      border: v('--border'),
    };
  }

  /** Re-express a theme color at a given alpha. The theme tokens are registered
      as `<color>`-typed custom properties, so getComputedStyle returns
      `rgb(r, g, b)` rather than the authored hex — parse both. Canvas silently
      ignores an unparseable value, so getting this wrong fails invisibly. */
  function withAlpha(color: string, a: number) {
    const fn = color.match(/rgba?\(([^)]+)\)/i);
    if (fn) {
      const [r, g, b] = fn[1].split(/[\s,/]+/).filter(Boolean).map(Number);
      return `rgba(${r}, ${g}, ${b}, ${a})`;
    }
    const h = color.replace('#', '').trim();
    const full = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
    const n = parseInt(full, 16);
    return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
  }

  function fitCanvas(canvas: HTMLCanvasElement, cleanups: Cleanups, onResize?: () => void) {
    const ctx = canvas.getContext('2d')!;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * dpr));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    const ro = new ResizeObserver(() => {
      size();
      onResize?.();
    });
    ro.observe(canvas);
    cleanups.push(() => ro.disconnect());
    return ctx;
  }

  /**
   * Run `fn` every frame until the theme transition has finished.
   *
   * The theme tokens are animated: :root transitions --bg, --text-primary and
   * the rest over 0.22s (see global.css). So for a moment after a switch,
   * getComputedStyle hands back a colour part-way between the two themes —
   * `rgb(67, 68, 66)` on the way from charcoal to paper. Redrawing once, on the
   * change event, samples one of those in-between values and strands the canvas
   * on it while the rest of the page carries on to the real colour. Alternating
   * themes quickly stranded it somewhere different every time.
   *
   * Each change extends the repaint window instead of starting a second loop,
   * so a burst of toggles coalesces into one continuous repaint that ends when
   * the last transition does.
   */
  function onThemeChange(fn: () => void, cleanups: Cleanups) {
    const SETTLE_MS = 340; // the 220ms token transition, plus headroom
    let raf = 0;
    let until = 0;

    const pump = () => {
      fn();
      // Read the clock after fn(): a long frame shouldn't cost us the last
      // repaint, which is the one that lands on the final colour.
      if (performance.now() < until) {
        raf = requestAnimationFrame(pump);
      } else {
        raf = 0;
      }
    };
    const bump = () => {
      until = performance.now() + SETTLE_MS;
      if (!raf) raf = requestAnimationFrame(pump);
    };

    const mo = new MutationObserver(bump);
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', bump);
    cleanups.push(() => {
      mo.disconnect();
      mq.removeEventListener('change', bump);
      cancelAnimationFrame(raf);
    });
  }

  function on<K extends keyof HTMLElementEventMap>(
    el: EventTarget,
    type: K,
    fn: (e: HTMLElementEventMap[K]) => void,
    cleanups: Cleanups,
    // wheel listeners are passive by default, and a passive listener cannot
    // preventDefault — which the zoom handler must, or the trackpad pinch
    // zooms the whole page instead of the graph.
    opts?: AddEventListenerOptions,
  ) {
    el.addEventListener(type, fn as EventListener, opts);
    cleanups.push(() => el.removeEventListener(type, fn as EventListener));
  }

  function initShelf(root: HTMLElement) {
    // Replace rather than refuse. Bailing out left whichever instance got there
    // first owning the canvas, which is wrong after a swap, and did nothing to
    // stop the stacked-loop case described above.
    instances.get(root)?.();

    const cleanups: Cleanups = [];
    instances.set(root, () => {
      while (cleanups.length) cleanups.pop()!();
      instances.delete(root);
    });
    root.dataset.sgReady = '1';

    const canvas = root.querySelector('[data-shelf-canvas]') as HTMLCanvasElement | null;
    const readout = root.querySelector('[data-shelf-readout]') as HTMLElement | null;
    const legend = root.querySelector('[data-shelf-legend]') as HTMLElement | null;
    const level = root.querySelector('[data-shelf-level]') as HTMLElement | null;
    if (!canvas || !readout || !legend) return;

    let items: Item[] = [];
    try {
      items = JSON.parse(canvas.dataset.shelfItems || '[]');
    } catch {
      items = [];
    }

    let colors = palette();
    /** Which HUES branch the legend was last built against — see onThemeChange. */
    let lastDark: boolean | null = null;
    let nodes: Node[] = [];
    let links: Array<[number, number]> = [];
    let adjacency: Set<number>[] = [];
    let alpha = 1;
    let settled = false;
    /** When the layout went still, and how long the labels take to fade in. */
    let settleAt = 0;
    let calm = 0;
    const CALM_PX = 0.35;
    const CALM_FRAMES = 4;
    const FADE_MS = 260;
    let hover = -1;
    let drag = -1;
    let anim = 0;

    /* Live pointers on the canvas, by pointerId. Two at once is a pinch; one
       on empty space is a pan; one on a node drags it. */
    const pointers = new Map<number, { x: number; y: number }>();
    /** The two-finger gesture in progress: its span and midpoint last frame. */
    let pinch: { dist: number; mx: number; my: number } | null = null;
    /** A one-finger / mouse drag of the background, moving the camera. */
    let panning: { x: number; y: number } | null = null;

    /* ---------------------------------------------------------- the camera */
    /**
     * The transform is two layers, not one.
     *
     * `fit` is the automatic part: whatever scale and offset drops the current
     * cloud into the canvas. `zoom` and `pan` are the reader's, applied on top
     * of it. Keeping them separate is what makes zoom stable — the reader's 3×
     * stays 3× when the layout shifts or the canvas resizes, because it is
     * expressed relative to the fit rather than baked into one absolute scale.
     *
     * `view` is the composition of the two, and is what everything else reads.
     * It is recomputed by syncView() rather than assigned to directly.
     */
    let fit = { s: 1, ox: 0, oy: 0 };
    let zoom = 1;
    let pan = { x: 0, y: 0 };
    let view = { s: 1, ox: 0, oy: 0 };

    /* The fixed boundary the reader zooms within.
     *
     * 1 is "the whole graph fits", so there is never a way to zoom out into
     * empty space. The ceiling is set from the size of the graph rather than
     * fixed: on this shelf (5 entries, 15 tags) a flat 8× put a single node on
     * an otherwise blank canvas — past the point where zooming tells you
     * anything. A denser collection genuinely needs to go further in, so it
     * scales with the node count and stops at 6×. */
    const MIN_ZOOM = 1;
    let maxZoom = 3;
    const setMaxZoom = () => {
      maxZoom = Math.min(6, Math.max(3, nodes.length / 6));
    };

    /** Whether the reader has taken the camera off its default. */
    const cameraMoved = () => zoom !== 1 || pan.x !== 0 || pan.y !== 0;

    /** The world-space bounding box of the cloud. */
    function bounds() {
      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
      for (const n of nodes) {
        minX = Math.min(minX, n.x); maxX = Math.max(maxX, n.x);
        minY = Math.min(minY, n.y); maxY = Math.max(maxY, n.y);
      }
      return { minX, maxX, minY, maxY };
    }

    /** Recompute the automatic layer: drop the whole cloud into the canvas. */
    function refit(w: number, h: number) {
      if (!nodes.length) return;
      const { minX, maxX, minY, maxY } = bounds();
      // Labels need room to sit outside the cloud; less of it on a narrow
      // canvas, where 64px a side is most of the width.
      const pad = w < 560 ? 40 : 64;
      const s = Math.min(
        (w - pad * 2) / Math.max(1, maxX - minX),
        (h - pad * 2) / Math.max(1, maxY - minY),
        1.5,
      );
      fit = {
        s,
        ox: w / 2 - ((minX + maxX) / 2) * s,
        oy: h / 2 - ((minY + maxY) / 2) * s,
      };
    }

    /**
     * Compose fit + zoom + pan into the transform everything else reads.
     *
     * The zoom is taken about the centre of the canvas, so that with pan at
     * zero the middle of the graph stays in the middle as it scales.
     */
    function syncView(w: number, h: number) {
      view = {
        s: fit.s * zoom,
        ox: (fit.ox - w / 2) * zoom + w / 2 + pan.x,
        oy: (fit.oy - h / 2) * zoom + h / 2 + pan.y,
      };
    }

    /**
     * Keep the cloud from being pushed out of its own frame.
     *
     * The boundary is the canvas: the transformed bounding box must always
     * overlap it by at least a margin on each axis, so there is no way to pan
     * into blank space and lose the graph with no obvious way back. When the
     * scaled graph is smaller than the canvas on an axis it is simply centred
     * on that axis instead of being allowed to drift.
     */
    function clampPan(w: number, h: number) {
      if (!nodes.length) return;
      const { minX, maxX, minY, maxY } = bounds();
      const s = fit.s * zoom;
      const MARGIN = 60;

      const axis = (lo: number, hi: number, fitOff: number, size: number, p: number) => {
        // Screen extent of the cloud at the current zoom, before this pan.
        const a = lo * s + (fitOff - size / 2) * zoom + size / 2;
        const b = hi * s + (fitOff - size / 2) * zoom + size / 2;
        if (b - a <= size) {
          // The whole cloud fits on this axis, so there is nothing to pan to:
          // centre it. This is what pins the fitted view in place at zoom 1.
          return size / 2 - (a + b) / 2;
        }
        // Bigger than the frame: pan freely, but keep at least MARGIN of the
        // cloud on screen at each end. After panning by p the extent is
        // [a + p, b + p], so the near edge must not pass size - MARGIN and the
        // far edge must not pass MARGIN.
        return Math.min(size - MARGIN - a, Math.max(MARGIN - b, p));
      };

      pan = {
        x: axis(minX, maxX, fit.ox, w, pan.x),
        y: axis(minY, maxY, fit.oy, h, pan.y),
      };
    }

    /**
     * Zoom by `factor`, keeping the world point under (px, py) fixed there.
     * Returns false when the zoom was already at its limit and nothing moved,
     * so a caller that also panned knows it still owes a repaint.
     */
    function zoomAt(px: number, py: number, factor: number) {
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      const next = Math.min(maxZoom, Math.max(MIN_ZOOM, zoom * factor));
      if (next === zoom) return false;

      // The world point currently under the pointer.
      syncView(w, h);
      const wx = (px - view.ox) / view.s;
      const wy = (py - view.oy) / view.s;

      zoom = next;
      // Solve for the pan that puts that same world point back under (px, py).
      pan = {
        x: px - wx * fit.s * zoom - (fit.ox - w / 2) * zoom - w / 2,
        y: py - wy * fit.s * zoom - (fit.oy - h / 2) * zoom - h / 2,
      };
      clampPan(w, h);
      syncView(w, h);
      reflectZoom();
      draw();
      return true;
    }

    /** Back to the fitted view. */
    function resetCamera() {
      zoom = 1;
      pan = { x: 0, y: 0 };
      reflectZoom();
      draw();
    }

    /** Mirror the camera into the controls: level, limits, and the reset. */
    function reflectZoom() {
      if (level) level.textContent = `${Math.round(zoom * 100)}%`;
      root.querySelectorAll<HTMLButtonElement>('[data-shelf-zoom]').forEach((btn) => {
        const kind = btn.dataset.shelfZoom;
        if (kind === 'in') btn.disabled = zoom >= maxZoom - 0.001;
        else if (kind === 'out') btn.disabled = zoom <= MIN_ZOOM + 0.001;
        // Reset stays out of the way until there is something to reset.
        else if (kind === 'reset') btn.hidden = !cameraMoved();
      });
    }

    const radius = (n: Node) =>
      n.kind === 'item' ? 6 + Math.min(4, n.deg * 0.7) : 2.4 + Math.min(3.6, n.deg * 0.7);

    /** Categories are free text in the CMS, so anything unrecognised falls
        through to `other` rather than vanishing into the background colour. */
    const hueKey = (cat: string | null) => {
      const k = (cat || '').trim().toLowerCase();
      return k && HUES[k] ? k : 'other';
    };
    // Theme is read off the resolved --bg rather than the media query, so the
    // manual toggle and the system preference both land in the right branch.
    const isDark = () => {
      const m = colors.bg.match(/\d+/g);
      if (!m) return false;
      const [r, g, b] = m.map(Number);
      return 0.299 * r + 0.587 * g + 0.114 * b < 128;
    };
    const hue = (key: string) => (HUES[key] || HUES.other)[isDark() ? 1 : 0];

    /** Bipartite: a node per entry, a node per tag, an edge for each tagging.
        Entries that share a tag are pulled together by that tag alone. */
    function build() {
      // Tag id → node index. Entries are NOT indexed by title: two entries can
      // legitimately share one (two editions, a book and the film of it), and
      // keying on it made the second overwrite the first, so one node collected
      // both sets of tags while the other floated unlinked. The entry's
      // position in `items` is the only identifier guaranteed unique.
      const tagIndex = new Map<string, number>();
      nodes = [];
      links = [];

      items.forEach((it) => {
        nodes.push({
          label: it.title, kind: 'item', hue: hueKey(it.category), url: it.url,
          deg: 0,
          x: 0, y: 0, vx: 0, vy: 0, pinned: false, slot: -1,
        });
      });
      items.forEach((it, from) => {
        // A tag repeated on one entry is one edge, not two — a duplicate would
        // double that tag's degree and its spring pull.
        new Set(it.tags).forEach((tag) => {
          let to = tagIndex.get(tag);
          if (to === undefined) {
            to = nodes.length;
            tagIndex.set(tag, to);
            nodes.push({
              label: tag, kind: 'tag', hue: 'tag', url: null, deg: 0,
              x: 0, y: 0, vx: 0, vy: 0, pinned: false, slot: -1,
            });
          }
          nodes[to].deg++;
          nodes[from].deg++;
          links.push([from, to]);
        });
      });

      adjacency = nodes.map(() => new Set<number>());
      links.forEach(([a, b]) => {
        adjacency[a].add(b);
        adjacency[b].add(a);
      });

      // Deterministic seeding — entries on an inner ellipse, tags on an outer
      // one — so the layout settles the same way on every load instead of
      // untangling from a different knot each time. Wider than tall, matching
      // the canvas, so it doesn't have to unfold sideways later.
      const itemCount = items.length;
      const tagCount = nodes.length - itemCount;
      let ci = 0;
      let ct = 0;
      nodes.forEach((n) => {
        if (n.kind === 'item') {
          const a = (ci++ / Math.max(1, itemCount)) * Math.PI * 2;
          n.x = Math.cos(a) * 115;
          n.y = Math.sin(a) * 72;
        } else {
          const a = (ct++ / Math.max(1, tagCount)) * Math.PI * 2 + 0.5;
          n.x = Math.cos(a) * 245;
          n.y = Math.sin(a) * 155;
        }
      });

      alpha = 1;
      settled = false;
      settleAt = 0;
      calm = 0;
      hover = -1;
      drag = -1;
      // A rebuild is a different graph; a camera aimed at the old one means
      // nothing. Reset before the first fit rather than leaving a stale zoom.
      zoom = 1;
      pan = { x: 0, y: 0 };
      setMaxZoom();
      pointers.clear();
      pinch = null;
      panning = null;
      refit(canvas!.clientWidth, canvas!.clientHeight);
      reflectZoom();
      readout!.textContent = `${itemCount} ${itemCount === 1 ? 'entry' : 'entries'} · ${tagCount} ${
        tagCount === 1 ? 'tag' : 'tags'
      } · ${links.length} links`;
      drawLegend();
      run();
    }

    /** Only the categories this collection actually uses, in the order it
        presents them — a fixed legend would list hues that aren't on screen. */
    function drawLegend() {
      const keys: string[] = [];
      items.forEach((it) => {
        const k = hueKey(it.category);
        if (!keys.includes(k)) keys.push(k);
      });
      if (nodes.some((n) => n.kind === 'tag')) keys.push('tag');

      lastDark = isDark();
      legend!.innerHTML = '';
      keys.forEach((k) => {
        const li = document.createElement('li');
        if (k === 'tag') li.classList.add('is-tag');
        li.style.color = hue(k);
        const dot = document.createElement('span');
        dot.className = 'sg-swatch';
        li.append(dot, document.createTextNode(k === 'other' ? 'uncategorised' : k));
        legend!.appendChild(li);
      });
    }

    function step() {
      const REP = 9000;
      const SPRING = 0.03;
      const REST = 92;
      // Equilibrium spread on an axis goes as 1/sqrt(gravity), so dividing the
      // x pull by aspect² lands the cloud at the canvas's own aspect ratio.
      // Labels are wide; that horizontal room is what stops them stacking up.
      const aspect = Math.max(1, canvas!.clientWidth / Math.max(1, canvas!.clientHeight));
      const GRAV_Y = 0.016;
      const GRAV_X = GRAV_Y / (aspect * aspect);
      const DAMP = 0.85;
      // Entries repel each other harder than tags do, which is what stops two
      // titles landing close enough that their labels fight.
      const ITEM_REP = 2.6;

      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) {
            // Perfectly coincident nodes have no direction to push apart along.
            dx = (i % 7) - 3;
            dy = (j % 5) - 2;
            d2 = dx * dx + dy * dy || 1;
          }
          const boost = a.kind === 'item' && b.kind === 'item' ? ITEM_REP : 1;
          const d = Math.sqrt(d2);
          const f = (REP * boost) / d2;
          const ux = (dx / d) * f;
          const uy = (dy / d) * f;
          a.vx += ux; a.vy += uy;
          b.vx -= ux; b.vy -= uy;
        }
      }

      for (const [i, j] of links) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 1;
        const f = (d - REST) * SPRING;
        const ux = (dx / d) * f;
        const uy = (dy / d) * f;
        a.vx += ux; a.vy += uy;
        b.vx -= ux; b.vy -= uy;
      }

      let maxMove = 0;
      for (const n of nodes) {
        n.vx -= n.x * GRAV_X;
        n.vy -= n.y * GRAV_Y;
        if (n.pinned) {
          n.vx = 0;
          n.vy = 0;
          continue;
        }
        n.vx *= DAMP;
        n.vy *= DAMP;
        const mx = n.vx * alpha;
        const my = n.vy * alpha;
        n.x += mx;
        n.y += my;
        const move = Math.abs(mx) + Math.abs(my);
        if (move > maxMove) maxMove = move;
      }
      alpha *= 0.985;

      /* Settle on how much the cloud is actually moving, not on alpha alone.
         alpha is a fixed decay curve — reaching 0.05 always takes ~200 frames,
         whatever the graph is doing — but the layout stops moving visibly long
         before that. Labels are gated on `settled`, so trusting alpha would
         hold them back for a couple of seconds after the picture is already
         still. A few consecutive near-motionless frames is the real signal;
         alpha stays as a backstop for a graph that never fully quiets. */
      if (maxMove < CALM_PX) calm++;
      else calm = 0;
      if (!settled && (calm >= CALM_FRAMES || alpha < 0.05)) {
        settled = true;
        settleAt = performance.now();
        // Converged: stop integrating. Left alone, alpha has seconds of decay
        // still to run, and that slow drift would slide nodes out from under
        // the labels the moment they were placed.
        alpha = Math.min(alpha, 0.02);
      }
    }

    const overlaps = (a: Rect, b: Rect) =>
      a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;

    /** Greedy label placement. Each label gets four candidate slots around its
        node; the first that clears everything already on the canvas wins, and a
        label with no free slot is dropped rather than drawn on top of another.
        Entries are placed first so a tag never displaces a title. Anything
        dropped is still reachable by hovering the node. */
    function placeLabels(order: number[], occupied: Rect[], w: number, h: number) {
      const placed: Array<{
        i: number; rect: Rect; align: CanvasTextAlign; tx: number; text: string;
      }> = [];

      for (const i of order) {
        const n = nodes[i];
        const item = n.kind === 'item';
        ctx.font = labelFont(item, w, zoom);
        // 16px of margin each side, matching the bounds check below.
        const text = fitText(ctx, item ? n.label : n.label.toUpperCase(), w - 32);
        const tw = ctx.measureText(text).width;
        // Line box tracks the type size, or the placement rectangles stop
        // matching what actually gets painted into them.
        const th = baseLabelSize(item, w) * labelScale(zoom) + 1.5;
        const cx = n.x * view.s + view.ox;
        const cy = n.y * view.s + view.oy;
        // A node off the edge can still have a slot that lands inside, which
        // paints a title with no dot under it — at high zoom the label of a
        // node well outside the frame was the only thing on screen. A label
        // belongs to its node, so it goes when the node does.
        if (cx < 0 || cy < 0 || cx > w || cy > h) {
          n.slot = -1;
          continue;
        }
        const r = radius(n) + 5;

        const slots: Array<{ rect: Rect; align: CanvasTextAlign; tx: number }> = [
          { rect: { x: cx - tw / 2, y: cy + r, w: tw, h: th }, align: 'center', tx: cx },
          { rect: { x: cx - tw / 2, y: cy - r - th, w: tw, h: th }, align: 'center', tx: cx },
          { rect: { x: cx + r, y: cy - th / 2, w: tw, h: th }, align: 'left', tx: cx + r },
          { rect: { x: cx - r - tw, y: cy - th / 2, w: tw, h: th }, align: 'right', tx: cx - r },
        ];

        // A node near an edge can have all four slots hang off the canvas. For
        // an entry that matters — the titles are the content — so slide the
        // label back inside and take it if it's still clear of everything.
        if (item) {
          const cx2 = Math.max(8, Math.min(cx - tw / 2, w - 8 - tw));
          slots.push(
            { rect: { x: cx2, y: cy + r, w: tw, h: th }, align: 'left', tx: cx2 },
            { rect: { x: cx2, y: cy - r - th, w: tw, h: th }, align: 'left', tx: cx2 },
          );
        }

        // Try the slot this label held last time before anything else. Two
        // slots are often both free, and picking the first that fits means a
        // label hops between them as its neighbours shift — during a drag, or
        // on the frame a hover changes what is on screen. Preferring the
        // incumbent means a label only moves when its slot is genuinely taken.
        const tryOrder = slots.map((_, k) => k);
        if (n.slot >= 0 && n.slot < slots.length) {
          tryOrder.splice(n.slot, 1);
          tryOrder.unshift(n.slot);
        }

        let took = -1;
        for (const k of tryOrder) {
          const slot = slots[k];
          const { x, y, w: rw, h: rh } = slot.rect;
          if (x < 8 || y < 8 || x + rw > w - 8 || y + rh > h - 8) continue;
          const pad = { x: x - 3, y: y - 2, w: rw + 6, h: rh + 4 };
          if (occupied.some((o) => overlaps(pad, o))) continue;
          occupied.push(pad);
          placed.push({ i, ...slot, text });
          took = k;
          break;
        }
        n.slot = took;
      }
      return placed;
    }

    function draw() {
      const w = canvas!.clientWidth;
      const h = canvas!.clientHeight;
      ctx.fillStyle = colors.bg;
      ctx.fillRect(0, 0, w, h);

      if (!nodes.length) {
        ctx.fillStyle = withAlpha(colors.dim, 0.9);
        ctx.font = `500 12px ${SANS}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('Nothing on the shelf yet.', w / 2, h / 2);
        return;
      }

      /* Re-fit only while the layout is still moving into place, and never
         during a drag.

         The fit is derived from the node bounding box, and the drag handler
         inverts the composed transform to turn a pointer position back into
         world coordinates — so recomputing it mid-drag is a feedback loop:
         pulling a node outward grows the box, which shrinks the scale, which
         re-maps the same finger position to a different world point, which
         moves the node again. On a phone, where a drag crosses most of the
         canvas, that reads as the whole graph lurching around.

         Freezing it once settled also means dragging one node no longer
         rescales everything around it, and the reader's own zoom is not
         quietly re-based underneath them. Resize and rebuild re-fit
         explicitly. */
      if (!settled && drag < 0) refit(w, h);
      if (drag < 0 && !pinch) clampPan(w, h);
      syncView(w, h);

      const X = (n: Node) => n.x * view.s + view.ox;
      const Y = (n: Node) => n.y * view.s + view.oy;

      const near = hover >= 0 ? adjacency[hover] : null;
      const lit = (i: number) => !near || i === hover || near.has(i);

      ctx.lineWidth = 1;
      for (const [a, b] of links) {
        const strong = near ? lit(a) && lit(b) : false;
        ctx.strokeStyle = near
          ? strong
            ? withAlpha(hue(nodes[a].hue), 0.75)
            : withAlpha(colors.border, 0.3)
          : withAlpha(colors.border, 0.85);
        ctx.beginPath();
        ctx.moveTo(X(nodes[a]), Y(nodes[a]));
        ctx.lineTo(X(nodes[b]), Y(nodes[b]));
        ctx.stroke();
      }

      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        const on = lit(i);
        const r = radius(n);
        ctx.beginPath();
        ctx.arc(X(n), Y(n), i === hover ? r * 1.4 : r, 0, Math.PI * 2);
        ctx.fillStyle = withAlpha(hue(n.hue), on ? (n.kind === 'item' ? 1 : 0.85) : 0.26);
        ctx.fill();
      }

      /* Nothing is labelled until the layout is still.
         placeLabels re-solves from scratch every frame, so while the cloud is
         still expanding a slot that was clear last frame is taken this one and
         the title snaps from below its node to above it — several times a
         second, which is the flicker. Fading in from alpha 0.3 started that
         two seconds before the graph stopped moving; the fade now runs on the
         clock, from the moment motion actually stopped. */
      const fade = settled ? Math.min(1, (performance.now() - settleAt) / FADE_MS) : 0;
      if (fade <= 0.01) return;

      // Nodes themselves are obstacles, so a label never lands on a dot.
      const occupied: Rect[] = nodes.map((n) => {
        const r = radius(n) + 3;
        return { x: X(n) - r, y: Y(n) - r, w: r * 2, h: r * 2 };
      });

      // Hovering isolates: only the hovered node's own neighbourhood is
      // labelled, which is what makes a dense graph readable at all.
      const candidates = near
        ? [hover, ...Array.from(near)]
        : nodes
            .map((_, i) => i)
            .sort((a, b) => {
              const ka = nodes[a].kind === 'item' ? 0 : 1;
              const kb = nodes[b].kind === 'item' ? 0 : 1;
              return ka - kb || nodes[b].deg - nodes[a].deg;
            });

      for (const p of placeLabels(candidates, occupied, w, h)) {
        const n = nodes[p.i];
        const item = n.kind === 'item';
        // Already trimmed to the measured width — re-deriving it here would
        // paint a wider string than the box that was reserved for it.
        const text = p.text;

        // Paint the page colour behind the text so a label crossing a link
        // stays readable without a box or a halo around it.
        ctx.fillStyle = colors.bg;
        ctx.fillRect(p.rect.x - 2, p.rect.y - 1, p.rect.w + 4, p.rect.h + 2);

        ctx.font = labelFont(item, w, zoom);
        ctx.fillStyle = withAlpha(hue(n.hue), (item ? 1 : 0.9) * fade);
        ctx.textAlign = p.align;
        ctx.textBaseline = 'top';
        ctx.fillText(text, p.tx, p.rect.y);
      }
    }

    // A resize changes what "fitted" means, so re-derive the automatic layer
    // even after the layout has settled — the reader's zoom is a multiplier on
    // top of it and survives untouched. Re-clamping the pan afterwards keeps a
    // zoomed-in view from ending up outside a canvas that just got smaller.
    const ctx = fitCanvas(canvas, cleanups, () => {
      refit(canvas.clientWidth, canvas.clientHeight);
      clampPan(canvas.clientWidth, canvas.clientHeight);
      draw();
    });

    function run() {
      cancelAnimationFrame(anim);
      const tick = () => {
        // Settling clamps alpha, so the fade needs its own reason to keep
        // frames coming — otherwise the labels stop half-way through.
        const fading = settled && performance.now() - settleAt < FADE_MS;
        if (alpha > 0.02 || drag >= 0 || fading) {
          step();
          draw();
          anim = requestAnimationFrame(tick);
        } else {
          draw();
        }
      };
      anim = requestAnimationFrame(tick);
    }
    // Registered once, not per run(): the closure reads whatever `anim` holds
    // when it fires, and pushing on every call (including every pointerdown)
    // just grew the list without cancelling anything extra.
    cleanups.push(() => cancelAnimationFrame(anim));

    function pick(ev: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      const px = ev.clientX - rect.left;
      const py = ev.clientY - rect.top;
      let best = -1;
      let bestD = 22 * 22;
      for (let i = 0; i < nodes.length; i++) {
        const dx = px - (nodes[i].x * view.s + view.ox);
        const dy = py - (nodes[i].y * view.s + view.oy);
        const d = dx * dx + dy * dy;
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      }
      return { i: best, px, py };
    }

    let downAt = 0;
    let moved = 0;

    /** Give up the current drag without treating it as a click. */
    function endDrag(e?: PointerEvent) {
      if (drag < 0) return;
      nodes[drag].pinned = false;
      drag = -1;
      canvas!.classList.remove('is-grabbing');
      if (e && canvas!.hasPointerCapture(e.pointerId)) canvas!.releasePointerCapture(e.pointerId);
      run();
    }

    /** Pointer position in canvas coordinates. */
    function local(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    /** The span and midpoint of the two live pointers, for a pinch. */
    function span() {
      const [a, b] = Array.from(pointers.values());
      return {
        dist: Math.hypot(a.x - b.x, a.y - b.y),
        mx: (a.x + b.x) / 2,
        my: (a.y + b.y) / 2,
      };
    }

    on(canvas, 'pointermove', (e) => {
      const p = local(e);
      if (pointers.has(e.pointerId)) pointers.set(e.pointerId, p);

      // A pinch outranks everything else: two fingers are never a node drag.
      if (pinch && pointers.size === 2) {
        const now = span();
        if (pinch.dist > 0) {
          const w = canvas!.clientWidth;
          const h = canvas!.clientHeight;
          // Follow the midpoint first, so two fingers moving together pan…
          pan.x += now.mx - pinch.mx;
          pan.y += now.my - pinch.my;
          // …then scale about where the midpoint now is, so the graph grows
          // out of the gesture rather than out of the middle of the canvas.
          // zoomAt clamps, syncs and repaints; if it was already at a limit
          // the pan above still needs applying.
          if (!zoomAt(now.mx, now.my, now.dist / pinch.dist)) {
            clampPan(w, h);
            syncView(w, h);
            draw();
          }
        }
        pinch = now;
        return;
      }

      if (panning) {
        pan.x += p.x - panning.x;
        pan.y += p.y - panning.y;
        panning = p;
        clampPan(canvas!.clientWidth, canvas!.clientHeight);
        draw();
        return;
      }

      const { i, px, py } = pick(e);
      if (drag >= 0) {
        moved++;
        nodes[drag].x = (px - view.ox) / view.s;
        nodes[drag].y = (py - view.oy) / view.s;
        // Enough to let the neighbours follow, but well short of re-heating the
        // whole cloud: at 0.3 every node moves visibly on every frame of the
        // drag, which is most of what made this feel out of control.
        alpha = Math.max(alpha, 0.12);
        return;
      }
      // Touch has no hover — a stray pointermove from a finger would leave the
      // graph isolated on whatever it last passed over, with no way to clear
      // it. Touch isolation is handled by tap, in pointerup below.
      if (e.pointerType !== 'mouse') return;
      if (i !== hover) {
        hover = i;
        if (alpha <= 0.02) draw();
      }
    }, cleanups);

    on(canvas, 'pointerdown', (e) => {
      pointers.set(e.pointerId, local(e));

      // Second finger down: whatever the first one was doing becomes a pinch.
      if (pointers.size === 2) {
        endDrag();
        panning = null;
        pinch = span();
        canvas.classList.add('is-grabbing');
        return;
      }
      if (pointers.size > 2) return;

      const { i } = pick(e);
      if (i < 0) {
        // Empty space drags the camera. Below the fit zoom there is nothing to
        // pan to — clampPan would undo it — so this only bites once zoomed in,
        // which is exactly when it is wanted.
        panning = local(e);
        canvas.classList.add('is-grabbing');
        canvas.setPointerCapture(e.pointerId);
        // A press on the background also clears a touch isolation.
        if (e.pointerType !== 'mouse' && hover !== -1) {
          hover = -1;
          draw();
        }
        return;
      }
      drag = i;
      moved = 0;
      downAt = performance.now();
      nodes[i].pinned = true;
      canvas.classList.add('is-grabbing');
      canvas.setPointerCapture(e.pointerId);
      alpha = Math.max(alpha, 0.3);
      run();
    }, cleanups);

    /** Shared by pointerup and pointercancel: forget this pointer, and end
        whatever gesture it was part of. */
    function releasePointer(e: PointerEvent) {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinch = null;
      if (pointers.size === 0) {
        panning = null;
        canvas!.classList.remove('is-grabbing');
      }
      if (canvas!.hasPointerCapture(e.pointerId)) canvas!.releasePointerCapture(e.pointerId);
    }

    on(canvas, 'pointerup', (e) => {
      const wasPinching = pinch !== null || pointers.size > 1;
      const wasPanning = panning !== null;
      releasePointer(e);
      // Lifting one finger of a pinch is not a tap on whatever is underneath.
      if (wasPinching || wasPanning) {
        endDrag(e);
        return;
      }
      if (drag < 0) return;

      const n = nodes[drag];
      const i = drag;
      // A quick press that didn't travel is a click, not a drag.
      const tapped = moved < 4 && performance.now() - downAt < 400;
      endDrag(e);
      if (!tapped) return;

      if (e.pointerType === 'mouse') {
        if (n.kind === 'item' && n.url) window.open(n.url, '_blank', 'noopener');
        return;
      }
      // Touch: the first tap isolates the node — which is the only way to read
      // a label the layout had to drop, since there is no hover to reveal it.
      // Tapping the node that is already isolated is the one that follows the
      // link, so a link is never opened by a stray tap.
      if (hover === i) {
        if (n.kind === 'item' && n.url) window.open(n.url, '_blank', 'noopener');
        return;
      }
      hover = i;
      draw();
    }, cleanups);

    // A touch that the browser decides to turn into a page scroll (see
    // touch-action: pan-y) cancels the pointer instead of ending it. Without
    // this the node stays pinned and `drag` stays set, so the next finger
    // anywhere on the canvas drags that node around.
    on(canvas, 'pointercancel', (e) => {
      releasePointer(e);
      endDrag(e);
    }, cleanups);

    on(canvas, 'pointerleave', (e) => {
      // Mouse only. A touch pointer stops existing when the finger lifts, so it
      // fires leave immediately after every tap — which would clear the
      // isolation that tap just set, on the same frame.
      if (e.pointerType !== 'mouse') return;
      if (hover !== -1) {
        hover = -1;
        if (alpha <= 0.02) draw();
      }
    }, cleanups);

    /**
     * Trackpad and mouse wheel.
     *
     * A pinch on a trackpad arrives as a wheel event with ctrlKey set — that is
     * the platform convention every browser follows, and it is also what
     * Cmd/Ctrl + wheel sends. Those zoom. A plain wheel is left alone so the
     * page keeps scrolling normally: hijacking it would re-create the scroll
     * trap this widget just got rid of, on desktop.
     */
    on(canvas, 'wheel', (e) => {
      if (!e.ctrlKey && !e.metaKey) return;
      e.preventDefault();
      const rect = canvas!.getBoundingClientRect();
      // deltaMode 1 is lines rather than pixels (Firefox); normalise so one
      // notch is a comparable step in both.
      const unit = e.deltaMode === 1 ? 16 : 1;
      zoomAt(e.clientX - rect.left, e.clientY - rect.top, Math.exp(-e.deltaY * unit * 0.01));
    }, cleanups, { passive: false });

    // Double-click / double-tap steps in, and steps back out at the top.
    on(canvas, 'dblclick', (e) => {
      const rect = canvas!.getBoundingClientRect();
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;
      if (zoom >= maxZoom - 0.01) resetCamera();
      else zoomAt(px, py, 2);
    }, cleanups);

    // The buttons zoom about the centre of the canvas, which is the only
    // sensible anchor when the gesture carries no position of its own.
    root.querySelectorAll<HTMLButtonElement>('[data-shelf-zoom]').forEach((btn) => {
      on(btn, 'click', () => {
        const kind = btn.dataset.shelfZoom;
        if (kind === 'reset') return resetCamera();
        zoomAt(canvas.clientWidth / 2, canvas.clientHeight / 2, kind === 'in' ? 1.5 : 1 / 1.5);
      }, cleanups);
    });

    onThemeChange(() => {
      colors = palette();
      // The legend's swatches are inline styles picked from HUES, which are two
      // fixed values rather than animated tokens — so they only need rewriting
      // when the light/dark branch actually flips, not on all ~20 frames of the
      // transition. Rebuilding the list every frame made it flicker.
      const dark = isDark();
      if (dark !== lastDark) {
        lastDark = dark;
        drawLegend();
      }
      draw();
    }, cleanups);

    build();
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-shelf]').forEach(initShelf);
  }

  function teardown() {
    for (const dispose of Array.from(instances.values())) dispose();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
