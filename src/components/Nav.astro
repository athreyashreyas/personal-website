---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/recommendations', label: 'Recommendations' },
  { href: '/lab', label: 'Lab' },
  { href: '/about', label: 'About' },
];

// A link is current if the path matches exactly, or is a section root
// that the current URL sits under (e.g. /writing/some-post). On client-side
// (view-transition) navigations this is re-computed in BaseLayout's script.
function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav class="site-nav" aria-label="Primary" transition:persist>
  <ul class="nav-links">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>

<style>
  .site-nav {
    font-family: var(--font-serif);
    padding-block: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    font-size: 1.1rem;
    min-width: 0;
  }

  li {
    margin: 0;
  }

  a {
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  a:hover {
    color: var(--accent-link);
    text-decoration: none;
  }

  a[aria-current='page'] {
    color: var(--accent-link);
  }

  /* Phone portrait: show every section (no horizontal scroll). The toggle
     tucks into the top-right, and the links sit centered below, wrapping
     onto a second row cleanly — balanced and uncrowded. */
  @media (max-width: 640px) {
    .site-nav {
      flex-direction: column;
      align-items: stretch;
      /* Tighter than before: the header is sticky on mobile, so keep the band
         slim to preserve reading space. */
      gap: 0.35rem;
      padding-block: 0.6rem 0.7rem;
    }

    .nav-links {
      order: 2;
      justify-content: center;
      gap: 0.4rem 1.15rem;
      font-size: 1.04rem;
      row-gap: 0.4rem;
    }

    /* the theme toggle sits alone, aligned to the top-right */
    .site-nav > :global(.theme-toggle) {
      order: 1;
      align-self: flex-end;
    }
  }
</style>
