---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/recommendations', label: 'Recommendations' },
  { href: '/lab', label: 'Lab' },
  { href: '/about', label: 'About' },
];

// A link is current if the path matches exactly, or is a section root
// that the current URL sits under (e.g. /writing/some-post). On client-side
// (view-transition) navigations this is re-computed in BaseLayout's script.
function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav class="site-nav" aria-label="Primary" transition:persist>
  {/* Phone portrait: a compact dropdown menu on the left. Closing on
      navigation / outside-click is handled in BaseLayout's inline script. */}
  <details class="nav-dd">
    <summary class="nav-dd-trigger" aria-label="Open navigation menu">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <span>Menu</span>
    </summary>
    <ul class="nav-dd-list">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>

  {/* Tablet and up: inline links. */}
  <ul class="nav-links">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <ThemeToggle />
</nav>

<style>
  .site-nav {
    font-family: var(--font-serif);
    padding-block: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    font-size: 1.1rem;
    min-width: 0;
  }

  li {
    margin: 0;
  }

  a {
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  a:hover {
    /* Nav links signal hover with color, not underline — this suppresses
       the global underline-on-hover rule (see global.css) unconditionally,
       independent of the color gate below. */
    text-decoration: none;
  }

  /* Color-on-hover only for devices with a real pointer. Touch has no
     "hover" — the tapped element gets a sticky :hover that only clears on
     the next tap elsewhere — so without this gate, tapping a link greened
     it immediately while the still-current page was ALSO green (aria-current
     only flips once the new page has actually loaded; see BaseLayout's
     astro:page-load handler). That produced two green tabs during the load
     gap. Gating to (hover: hover) means the ONLY thing that ever greens a
     nav link is aria-current — one link is current at a time, and it only
     changes after navigation completes. */
  @media (hover: hover) {
    a:hover {
      color: var(--accent-link);
    }
  }

  a[aria-current='page'] {
    color: var(--accent-link);
  }

  /* The dropdown is phone-only; hidden on tablet and up. */
  .nav-dd {
    display: none;
  }

  /* Phone portrait: one slim row — menu button on the left, toggle on the
     right — instead of the tall wrapped list. */
  @media (max-width: 640px) {
    .site-nav {
      padding-block: 0.85rem;
    }

    .nav-links {
      display: none;
    }

    .nav-dd {
      display: flex;
      align-items: center;
      position: relative;
    }

    .nav-dd-trigger {
      list-style: none;
      list-style-type: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      /* Match the theme toggle's height so the two sit as a balanced pair,
         vertically centred on the same line. */
      height: 2.1rem;
      cursor: pointer;
      font-family: var(--font-serif);
      /* Sized up to read with the same visual weight as the solid 2.1rem
         toggle circle beside it — the previous 1.05rem/1.35rem pairing left
         this side of the row looking thin next to it. */
      font-size: 1.25rem;
      line-height: 1;
      color: var(--text-secondary);
      padding: 0 0.1rem;
      -webkit-tap-highlight-color: transparent;
    }
    /* hide the native disclosure triangle */
    .nav-dd-trigger::-webkit-details-marker {
      display: none;
    }
    .nav-dd-trigger svg {
      width: 1.7rem;
      height: 1.7rem;
      transition: color 0.2s ease;
    }
    /* The serif label's glyphs sit above the line-box centre, so it reads high
       next to the hamburger and toggle. Nudge just the text down to align the
       three optically. */
    .nav-dd-trigger span {
      display: inline-block;
      transform: translateY(1.5px);
    }
    .nav-dd[open] .nav-dd-trigger,
    .nav-dd-trigger:hover {
      color: var(--accent-link);
    }

    .nav-dd-list {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      z-index: 200;
      min-width: 12.5rem;
      list-style: none;
      margin: 0;
      padding: 0.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 14px 34px -12px rgba(0, 0, 0, 0.3);
    }

    .nav-dd-list a {
      display: block;
      padding: 0.55rem 0.7rem;
      border-radius: 9px;
      font-size: 1.05rem;
      white-space: nowrap;
    }
    /* Same (hover: hover) gate as the desktop links above — this list only
       ever shows on phone (see .nav-dd, max-width: 640px), where a tap would
       otherwise stick this hover tint on the destination item pre-navigation. */
    @media (hover: hover) {
      .nav-dd-list a:hover {
        background: color-mix(in srgb, var(--accent-link) 10%, transparent);
        color: var(--accent-link);
      }
    }
    .nav-dd-list a[aria-current='page'] {
      color: var(--accent-link);
      background: color-mix(in srgb, var(--accent-link) 13%, transparent);
    }

    .nav-dd[open] .nav-dd-list {
      animation: nav-dd-in 0.18s ease;
    }
    @keyframes nav-dd-in {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }
    }
  }

  @media (max-width: 640px) and (prefers-reduced-motion: reduce) {
    .nav-dd[open] .nav-dd-list {
      animation: none;
    }
  }
</style>
