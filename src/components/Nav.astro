---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/recommendations', label: 'Recommendations' },
  { href: '/lab', label: 'Lab' },
  { href: '/about', label: 'About' },
];

// A link is current if the path matches exactly, or is a section root
// that the current URL sits under (e.g. /writing/some-post). On client-side
// (view-transition) navigations this is re-computed in BaseLayout's script.
function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav class="site-nav" aria-label="Primary" transition:persist>
  <ul class="nav-links">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>

<style>
  .site-nav {
    font-family: var(--font-serif);
    padding-block: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    font-size: 1.1rem;
    min-width: 0;
  }

  li {
    margin: 0;
  }

  a {
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  a:hover {
    color: var(--accent-link);
    text-decoration: none;
  }

  a[aria-current='page'] {
    color: var(--accent-link);
  }

  /* Mobile: keep the links on one line and let them scroll horizontally
     instead of wrapping (so nothing like "About" drops to a second row).
     The toggle stays pinned on the right; links slide under a soft fade. */
  @media (max-width: 640px) {
    .site-nav {
      padding-block: 1.1rem;
      gap: 0.85rem;
    }

    .nav-links {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 1.15rem;
      font-size: 1.02rem;
      scrollbar-width: none; /* Firefox */
      -webkit-overflow-scrolling: touch;
      /* fade the trailing edge to hint that the row scrolls */
      -webkit-mask-image: linear-gradient(
        to right,
        #000 calc(100% - 1.25rem),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        #000 calc(100% - 1.25rem),
        transparent
      );
    }

    .nav-links::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }

    li {
      flex: none;
    }
  }
</style>
