---
// Theme toggle: a two-tone split circle. One half is the theme's foreground
// (dark in light mode, light in dark mode — it "turns dark/white"), the other
// half is the brand green. Click handling lives in BaseLayout's inline script.
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle light or dark theme"
  title="Toggle light / dark"
></button>

<style>
  .theme-toggle {
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    /* one half flips dark/white with the theme; the other half stays green */
    background: linear-gradient(
      135deg,
      var(--text-primary) 0 50%,
      var(--accent-link) 50% 100%
    );
    cursor: pointer;
    box-shadow: var(--toggle-shadow);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .theme-toggle:hover {
    transform: translateY(-1px) scale(1.04);
    box-shadow: var(--toggle-shadow-hover);
  }
</style>
