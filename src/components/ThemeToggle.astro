---
// Theme toggle: a two-tone split circle. One half is the theme's foreground
// (dark in light mode, light in dark mode — it "turns dark/white"), the other
// half is the brand green. Click handling lives in BaseLayout's inline script.
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle light or dark theme"
  title="Toggle light / dark"
></button>

<style>
  .theme-toggle {
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    /* one half flips dark/white with the theme; the other half stays green */
    background: linear-gradient(
      135deg,
      var(--text-primary) 0 50%,
      var(--accent-link) 50% 100%
    );
    cursor: pointer;
    box-shadow: var(--toggle-shadow);
    -webkit-tap-highlight-color: transparent;
    transition:
      /* glow swells in slowly and settles, like a lamp warming up */
      box-shadow 0.6s cubic-bezier(0.25, 0.8, 0.35, 1),
      transform 0.2s ease;
  }

  .theme-toggle:hover {
    transform: translateY(-1px) scale(1.04);
    box-shadow: var(--toggle-shadow-hover);
  }

  /* Dimmer glow in dark mode so the toggle doesn't over-luminesce. */
  :global(html[data-theme='dark']) .theme-toggle {
    box-shadow: 0 0 6px rgba(242, 238, 228, 0.16);
  }

  :global(html[data-theme='dark']) .theme-toggle:hover {
    box-shadow: 0 0 10px rgba(242, 238, 228, 0.26);
  }
</style>
